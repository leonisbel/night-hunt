for y = 0, SROWS - 1 do for x = 0, SCOLS - 1 do
	snow[#snow + 1] = new("Frame", { BorderSizePixel = 0, Size = UDim2.fromScale(1 / SCOLS + 0.002, 1 / SROWS + 0.004), Position = UDim2.fromScale(x / SCOLS, y / SROWS), ZIndex = 16 }, staticOver)
end end
