      <string name="Name">Workspace</string>
      <bool name="NeedsPivotMigration">false</bool>
      <bool name="StreamingEnabled">true</bool>
      <int name="StreamingMinRadius">160</int>
      <int name="StreamingTargetRadius">640</int>
    </Properties>
    <Item class="SpawnLocation" referent="22">
      <Properties>
        <string name="Name">LobbySpawn</string>
        <bool name="Anchored">true</bool>
        <Color3uint8 name="Color3uint8">2831168</Color3uint8>
        <int name="Duration">0</int>
        <token name="Material">1088</token>
        <bool name="Neutral">true</bool>
        <Vector3 name="Position">
          <X>0</X>
          <Y>0.5</Y>
          <Z>45</Z>
        </Vector3>
        <Vector3 name="size">
          <X>12</X>
          <Y>1</Y>
          <Z>12</Z>
        </Vector3>
      </Properties>
    </Item>
