      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[-- Night Hunt shared settings (fan-made monster survival game)
local C = {}

C.MIN_PLAYERS = 2        -- to take off (1 is allowed when testing in Studio)
C.MAX_PLAYERS = 15       -- hard cap per server
C.ROUND_TIME = 150       -- seconds survivors must last
C.EXTRACT_AT = 60        -- extraction helicopter lands with this many seconds left
C.FLIGHT_TIME = 4
C.RESULTS_TIME = 9
C.MONSTER_CHANCE = 0.2   -- each player's chance to become a monster
C.SURVIVOR_SPEED = 16
C.SPRINT_MULT = 1.55
C.CATCH_REACH = 6
C.LOBBY_PAD = Vector3.new(0, 0, 0)
C.PAD_RADIUS = 16
C.MAP_ORIGIN = Vector3.new(1200, 0, 0)
C.MAP_SIZE = 360

C.THEMES = { "Abandoned Pizzeria Town", "Foggy Woods", "Static Fields" }

C.MONSTER_KEYS = { "freddy", "bonnie", "chica", "foxy", "springtrap", "cartooncat",
	"sirenhead", "boiledone", "drnowhere", "locust", "monochrome", "demogorgon" }

C.MONSTERS = {
	freddy     = { name = "Freddy",         ability = "Lights Out",         desc = "Every survivor's flashlight dies for 5s",          cd = 18, speed = 19 },
	bonnie     = { name = "Bonnie",         ability = "Guitar Riff",        desc = "Stun survivors near you for 1.8s",                 cd = 14, speed = 19 },
	chica      = { name = "Chica",          ability = "Cupcake Trap",       desc = "Drop a cupcake trap (max 3) that roots survivors", cd = 7,  speed = 18.5 },
	foxy       = { name = "Foxy",           ability = "Pirate Dash",        desc = "Run super fast for 1.3s",                          cd = 10, speed = 19.5 },
	springtrap = { name = "Springtrap",     ability = "Vent Crawl",         desc = "Teleport to a vent near the closest survivor",     cd = 16, speed = 18.5 },
	cartooncat = { name = "Cartoon Cat",    ability = "Rubber Arms",        desc = "Triple catch reach for 3s",                        cd = 14, speed = 20 },
	sirenhead  = { name = "Siren Head",     ability = "Siren Call",         desc = "Reveal every survivor for 5s",                     cd = 18, speed = 18 },
	boiledone  = { name = "The Boiled One", ability = "Dread Gaze",         desc = "Survivors near you move 50% slower for 4s",        cd = 15, speed = 18.5 },
	drnowhere  = { name = "Doctor Nowhere", ability = "Nowhere Warp",       desc = "Blink forward, even through walls",                cd = 9,  speed = 19 },
	locust     = { name = "The Locust",     ability = "Static Fade",        desc = "Turn invisible for 5s",                            cd = 17, speed = 19 },
	monochrome = { name = "Monochrome",     ability = "Color Drain",        desc = "Survivors go grey and can't sprint for 5s",        cd = 16, speed = 19 },
	demogorgon = { name = "Demogorgon",     ability = "Upside Down Portal", desc = "Place a portal, use again to jump back to it",     cd = 14, speed = 19.5 },
}

return C
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="4">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="5">
      <Properties>
        <string name="Name">NightHuntServer</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--[[
	Night Hunt (fan-made) - server
	Hub servers: create / join-by-code / browse public matches. Each match is a Roblox
	reserved server (TeleportService:ReserveServer). Match servers run the lobby ->
	helicopter flight -> hunt -> results loop for 2-15 players.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TeleportService = game:GetService("TeleportService")
local MemoryStoreService = game:GetService("MemoryStoreService")
local TextService = game:GetService("TextService")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("NightHunt")
local Config = require(Shared:WaitForChild("Config"))
local Models = require(script:WaitForChild("Models"))
local MapGen = require(script:WaitForChild("MapGen"))

---------------------------------------------------------------------------
-- Remotes, replicated state, templates
---------------------------------------------------------------------------
local function make(className, name, parent)
	local i = Instance.new(className)
	i.Name = name
	i.Parent = parent
	return i
end
local Remotes = make("Folder", "Remotes", Shared)
local Action = make("RemoteEvent", "Action", Remotes)   -- client -> server
local Notify = make("RemoteEvent", "Notify", Remotes)   -- server -> client
local Hub = make("RemoteFunction", "Hub", Remotes)      -- hub requests
local State = make("Folder", "State", Shared)
local Templates = make("Folder", "Templates", Shared)
for _, k in ipairs(Config.MONSTER_KEYS) do Models.template(k).Parent = Templates end

local IS_STUDIO = RunService:IsStudio()
local CAN_TELEPORT = game.PlaceId ~= 0 and not IS_STUDIO
local IS_RESERVED = game.PrivateServerId ~= "" and game.PrivateServerOwnerId == 0
local IS_VIP = game.PrivateServerId ~= "" and game.PrivateServerOwnerId ~= 0

local settings = { code = "", name = "Night Hunt", max = Config.MAX_PLAYERS, public = false, hostId = 0 }
local function setState(k, v) State:SetAttribute(k, v) end
local function publishSettings()
	setState("ServerCode", settings.code)
	setState("ServerName", settings.name)
	setState("MaxPlayers", settings.max)
	setState("IsPublic", settings.public)
	setState("HostUserId", settings.hostId)
end
setState("Mode", (IS_RESERVED or IS_VIP) and "Match" or "Hub")
setState("State", "Lobby")
setState("TimeLeft", 0)
setState("Theme", "")
setState("Studio", not CAN_TELEPORT)
publishSettings()
if IS_VIP then
	settings.name = "Private server"
	settings.hostId = game.PrivateServerOwnerId
	publishSettings()
end

local function toast(target, msg)
	if target then Notify:FireClient(target, "toast", msg) else Notify:FireAllClients("toast", msg) end
end

---------------------------------------------------------------------------
-- Lobby: helipad + helicopter at the origin
---------------------------------------------------------------------------
local lobby = Instance.new("Model")
lobby.Name = "Lobby"
do
	local function part(size, cf, color, mat, shape)
		local p = Instance.new("Part")
		p.Anchored = true
		p.Size = size
		p.CFrame = cf
		p.Color = color
		p.Material = mat or Enum.Material.SmoothPlastic
		if shape then p.Shape = shape end
		p.TopSurface = Enum.SurfaceType.Smooth
		p.Parent = lobby
		return p
	end
	part(Vector3.new(160, 2, 160), CFrame.new(0, -1, 0), Color3.fromRGB(40, 44, 48), Enum.Material.Concrete)
	part(Vector3.new(0.5, Config.PAD_RADIUS * 2, Config.PAD_RADIUS * 2), CFrame.new(0, 0.25, 0) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(60, 60, 60), Enum.Material.Concrete, Enum.PartType.Cylinder)
	part(Vector3.new(0.55, Config.PAD_RADIUS * 2 - 1, Config.PAD_RADIUS * 2 - 1), CFrame.new(0, 0.27, 0) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(230, 180, 40), Enum.Material.Neon, Enum.PartType.Cylinder).Transparency = 0.6
	part(Vector3.new(0.6, Config.PAD_RADIUS * 2 - 3, Config.PAD_RADIUS * 2 - 3), CFrame.new(0, 0.3, 0) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(60, 60, 60), Enum.Material.Concrete, Enum.PartType.Cylinder)
	part(Vector3.new(2, 0.62, 12), CFrame.new(-4, 0.32, 9), Color3.fromRGB(240, 240, 240), Enum.Material.Neon)
	part(Vector3.new(2, 0.62, 12), CFrame.new(4, 0.32, 9), Color3.fromRGB(240, 240, 240), Enum.Material.Neon)
	part(Vector3.new(8, 0.62, 2), CFrame.new(0, 0.32, 9), Color3.fromRGB(240, 240, 240), Enum.Material.Neon)
	for _, x in ipairs({ -60, 60 }) do
		for _, z in ipairs({ -60, 60 }) do
			part(Vector3.new(1, 18, 1), CFrame.new(x, 9, z), Color3.fromRGB(30, 30, 30), Enum.Material.Metal)
			local bulb = part(Vector3.new(2, 1, 2), CFrame.new(x, 18.5, z), Color3.fromRGB(255, 200, 120), Enum.Material.Neon)
			local l = Instance.new("PointLight")
			l.Range = 40
			l.Color = Color3.fromRGB(255, 200, 120)
			l.Parent = bulb
		end
	end
	local heli = Models.helicopter(CFrame.new(0, 0.6, -2) * CFrame.Angles(0, math.rad(180), 0))
	heli.Parent = lobby
	local sign = part(Vector3.new(24, 7, 1), CFrame.new(0, 6, 34), Color3.fromRGB(20, 10, 10), Enum.Material.Slate)
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Back
	gui.CanvasSize = Vector2.new(480, 140)
	gui.Parent = sign
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.Font = Enum.Font.Creepster
	t.TextScaled = true
	t.TextColor3 = Color3.fromRGB(220, 40, 40)
	t.Text = "NIGHT HUNT\nboard the helicopter"
	t.Parent = gui
end
lobby.Parent = workspace

local function inPad(char)
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return false end
	local p = hrp.Position
	return Vector2.new(p.X, p.Z).Magnitude <= Config.PAD_RADIUS + 2 and p.Y < 25
end

---------------------------------------------------------------------------
-- Server registry (MemoryStore) shared by every hub + match server
---------------------------------------------------------------------------
local registry
pcall(function() registry = MemoryStoreService:GetSortedMap("NightHuntServers") end)
local CODE_CHARS = "ABCDEFGHJKMNPQRSTUVWXYZ23456789"
local function newCode()
	local s = ""
	for _ = 1, 5 do
		local i = math.random(1, #CODE_CHARS)
		s ..= CODE_CHARS:sub(i, i)
	end
	return s
end
local function filterName(text, player)
	text = tostring(text or ""):sub(1, 30):gsub("[%c]", "")
	if text:match("^%s*$") then text = player.DisplayName .. "'s server" end
	local ok, res = pcall(function()
		return TextService:FilterStringAsync(text, player.UserId):GetNonChatStringForBroadcastAsync()
	end)
	return ok and res or (player.DisplayName .. "'s server")
end
local function clampMax(n) return math.clamp(math.floor(tonumber(n) or 8), 2, Config.MAX_PLAYERS) end

local function updateRegistry()
	if not registry or settings.code == "" or not CAN_TELEPORT then return end
	local count = #Players:GetPlayers()
	pcall(function()
		registry:UpdateAsync(settings.code, function(old)
			if not old then return nil end
			old.players = count
			old.max = settings.max
			old.public = settings.public
			old.name = settings.name
			old.state = State:GetAttribute("State")
			old.updated = os.time()
			return old
		end, 120)
	end)
end

---------------------------------------------------------------------------
-- Round state
---------------------------------------------------------------------------
local fx = {}          -- [player] = { stunUntil, slowUntil, rootUntil, greyUntil, dashUntil, reachUntil, invisUntil, sprint, stamina }
local currentMap       -- MapGen info
local roundFolder      -- holds map, traps, portals, extraction heli
local extractionOpen = false
local monsterTraps = {} -- [player] = { parts }
local portals = {}      -- [player] = part
local cooldowns = {}    -- [player] = os.clock() ready time

local function F(p)
	fx[p] = fx[p] or { stamina = 100 }
	return fx[p]
end
local function now() return os.clock() end
local function hrpOf(p)
	local c = p.Character
	return c and c:FindFirstChild("HumanoidRootPart")
end
local function humOf(p)
	local c = p.Character
	return c and c:FindFirstChildOfClass("Humanoid")
end
local function isHunting(p)
	return State:GetAttribute("State") == "Hunt" and p:GetAttribute("Alive") == true and p:GetAttribute("Escaped") ~= true
end
local function survivors(onlyActive)
	local list = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p:GetAttribute("Role") == "Survivor" and (not onlyActive or isHunting(p)) then table.insert(list, p) end
	end
	return list
end
local function monsters()
	local list = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p:GetAttribute("Role") == "Monster" then table.insert(list, p) end
	end
	return list
end
local function sendToLobby(p)
	local c = p.Character
	if c then
		local fl = c:FindFirstChild("NH_Flashlight", true)
		if fl then fl:Destroy() end
		c:PivotTo(CFrame.new(math.random(-20, 20), 4, 40 + math.random(-6, 6)))
	end
end
local function giveFlashlight(p)
	local hrp = hrpOf(p)
	if not hrp then return end
	local att = Instance.new("Attachment")
	att.Name = "NH_Flashlight"
	att.Position = Vector3.new(0, 1.2, -0.6)
	att.Parent = hrp
	local s = Instance.new("SpotLight")
	s.Face = Enum.NormalId.Front
	s.Range = 48
	s.Angle = 55
	s.Brightness = 3.2
	s.Color = Color3.fromRGB(255, 244, 214)
	s.Shadows = true
	s.Parent = att
	local glow = Instance.new("PointLight")
	glow.Range = 7
	glow.Brightness = 0.35
	glow.Parent = att
end

local function resetPlayer(p)
	p:SetAttribute("Role", "")
	p:SetAttribute("Monster", "")
	p:SetAttribute("Alive", true)
	p:SetAttribute("Escaped", false)
	p:SetAttribute("AbilityReadyAt", 0)
	p:SetAttribute("PortalSet", false)
	fx[p] = { stamina = 100 }
	cooldowns[p] = 0
end

---------------------------------------------------------------------------
-- Abilities
---------------------------------------------------------------------------
local function nearestSurvivor(from)
	local best, bestD
	for _, s in ipairs(survivors(true)) do
		local h = hrpOf(s)
		if h then
			local d = (h.Position - from).Magnitude
			if not bestD or d < bestD then best, bestD = s, d end
		end
	end
	return best, bestD
end

local function survivorsNear(pos, radius)
	local list = {}
	for _, s in ipairs(survivors(true)) do
		local h = hrpOf(s)
		if h and (h.Position - pos).Magnitude <= radius then table.insert(list, s) end
	end
	return list
end

local function setMorphTransparency(p, hidden)
	local morph = p.Character and p.Character:FindFirstChild("NH_Morph")
	if not morph then return end
	for _, d in ipairs(morph:GetDescendants()) do
		if d:IsA("BasePart") and d.Name ~= "Root" then
			if d:GetAttribute("BaseT") == nil then d:SetAttribute("BaseT", d.Transparency) end
			d.Transparency = hidden and 1 or d:GetAttribute("BaseT")
		elseif d:IsA("PointLight") then
			d.Enabled = not hidden
		end
	end
end

local function spaceFree(pos)
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local chars = {}
	for _, pl in ipairs(Players:GetPlayers()) do if pl.Character then table.insert(chars, pl.Character) end end
	params.FilterDescendantsInstances = chars
	local hits = workspace:GetPartBoundsInBox(CFrame.new(pos), Vector3.new(3, 5, 3), params)
	for _, h in ipairs(hits) do
		if h.CanCollide then return false end
	end
	return true
end

local ABILITY = {}
ABILITY.freddy = function(p)
	for _, s in ipairs(survivors(true)) do
		local h = hrpOf(s)
		local fl = h and h:FindFirstChild("NH_Flashlight")
		if fl then
			for _, l in ipairs(fl:GetChildren()) do l.Enabled = false end
			task.delay(5, function()
				if fl.Parent then for _, l in ipairs(fl:GetChildren()) do l.Enabled = true end end
			end)
		end
		Notify:FireClient(s, "effect", "lightsout", 5)
		toast(s, "Freddy: LIGHTS OUT!")
	end
	return true
end
ABILITY.bonnie = function(p)
	local list = survivorsNear(hrpOf(p).Position, 25)
	for _, s in ipairs(list) do F(s).stunUntil = now() + 1.8; toast(s, "Bonnie's guitar riff stunned you!") end
	toast(p, ("Guitar Riff hit %d survivor(s)"):format(#list))
	return true
end
ABILITY.chica = function(p)
	local h = hrpOf(p)
	monsterTraps[p] = monsterTraps[p] or {}
	local traps = monsterTraps[p]
	if #traps >= 3 then
		local old = table.remove(traps, 1)
		if old then old:Destroy() end
	end
	local trap = Instance.new("Part")
	trap.Name = "CupcakeTrap"
	trap.Shape = Enum.PartType.Cylinder
	trap.Size = Vector3.new(0.6, 3, 3)
	trap.CFrame = CFrame.new(h.Position.X, h.Position.Y - 2.7, h.Position.Z) * CFrame.Angles(0, 0, math.rad(90))
	trap.Color = Color3.fromRGB(255, 122, 182)
	trap.Material = Enum.Material.Neon
	trap.Transparency = 0.25
	trap.Anchored = true
	trap.CanCollide = false
	trap.Parent = roundFolder
	table.insert(traps, trap)
	toast(p, "Cupcake trap placed")
	return true
end
ABILITY.foxy = function(p) F(p).dashUntil = now() + 1.3; return true end
ABILITY.springtrap = function(p)
	local target = nearestSurvivor(hrpOf(p).Position)
	if not target or not currentMap or #currentMap.vents == 0 then toast(p, "No vents nearby"); return false end
	local tp = hrpOf(target).Position
	local best, bestD
	for _, v in ipairs(currentMap.vents) do
		local d = (v - tp).Magnitude
		if not bestD or d < bestD then best, bestD = v, d end
	end
	p.Character:PivotTo(CFrame.new(best))
	toast(p, "You crawled out of a vent")
	return true
end
ABILITY.cartooncat = function(p) F(p).reachUntil = now() + 3; return true end
ABILITY.sirenhead = function(p)
	for _, s in ipairs(survivors(true)) do
		if s.Character then
			local hl = Instance.new("Highlight")
			hl.Name = "NH_Reveal"
			hl.FillColor = Color3.fromRGB(255, 40, 40)
			hl.OutlineColor = Color3.fromRGB(255, 255, 255)
			hl.FillTransparency = 0.4
			hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			hl.Parent = s.Character
			task.delay(5, function() hl:Destroy() end)
		end
		Notify:FireClient(s, "effect", "siren", 5)
		toast(s, "Siren Head's call revealed everyone!")
	end
	return true
end
ABILITY.boiledone = function(p)
	local list = survivorsNear(hrpOf(p).Position, 40)
	for _, s in ipairs(list) do F(s).slowUntil = now() + 4; toast(s, "The Boiled One's gaze slows you...") end
	toast(p, ("Dread Gaze slowed %d survivor(s)"):format(#list))
	return true
end
ABILITY.drnowhere = function(p)
	local h = hrpOf(p)
	local look = h.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	if flat.Magnitude < 0.01 then flat = Vector3.new(0, 0, -1) end
	flat = flat.Unit
	for _, dist in ipairs({ 30, 25, 20, 15, 10 }) do
		local target = h.Position + flat * dist
		if currentMap then
			local o = Config.MAP_ORIGIN
			target = Vector3.new(
				math.clamp(target.X, o.X - currentMap.half + 4, o.X + currentMap.half - 4),
				target.Y,
				math.clamp(target.Z, o.Z - currentMap.half + 4, o.Z + currentMap.half - 4))
		end
		if spaceFree(target) then
			p.Character:PivotTo(CFrame.lookAt(target, target + flat))
			return true
		end
	end
	toast(p, "Something blocks the warp")
	return false
end
ABILITY.locust = function(p)
	F(p).invisUntil = now() + 5
	setMorphTransparency(p, true)
	task.delay(5, function()
		if p.Parent and F(p).invisUntil and now() >= F(p).invisUntil - 0.05 then setMorphTransparency(p, false) end
	end)
	toast(p, "You faded into static")
	return true
end
ABILITY.monochrome = function(p)
	for _, s in ipairs(survivors(true)) do
		F(s).greyUntil = now() + 5
		Notify:FireClient(s, "effect", "grey", 5)
		toast(s, "Monochrome drained your color - no sprinting!")
	end
	return true
end
ABILITY.demogorgon = function(p)
	local h = hrpOf(p)
	local portal = portals[p]
	if portal and portal.Parent then
		p.Character:PivotTo(CFrame.new(portal.Position + Vector3.new(0, 3, 0)))
		portal:Destroy()
		portals[p] = nil
		p:SetAttribute("PortalSet", false)
		toast(p, "You came out of the Upside Down")
		return true
	end
	local part = Instance.new("Part")
	part.Name = "UpsideDownPortal"
	part.Shape = Enum.PartType.Cylinder
	part.Size = Vector3.new(0.3, 7, 7)
	part.CFrame = CFrame.new(h.Position.X, h.Position.Y - 2.8, h.Position.Z) * CFrame.Angles(0, 0, math.rad(90))
	part.Color = Color3.fromRGB(150, 20, 30)
	part.Material = Enum.Material.Neon
	part.Anchored = true
	part.CanCollide = false
	part.Parent = roundFolder
	portals[p] = part
	p:SetAttribute("PortalSet", true)
	toast(p, "Portal placed - use the ability again to jump back to it")
	return "short"
end

local function useAbility(p)
	if not isHunting(p) or p:GetAttribute("Role") ~= "Monster" or not hrpOf(p) then return end
	if now() < (cooldowns[p] or 0) then return end
	local kind = p:GetAttribute("Monster")
	local fn = ABILITY[kind]
	local def = Config.MONSTERS[kind]
	if not fn or not def then return end
	local result = fn(p)
	if result then
		local cd = result == "short" and 2 or def.cd
		cooldowns[p] = now() + cd
		p:SetAttribute("AbilityReadyAt", workspace:GetServerTimeNow() + cd)
		Notify:FireAllClients("ability", p.UserId, kind)
	end
end

---------------------------------------------------------------------------
-- Round flow
---------------------------------------------------------------------------
local roundToken = 0

local function cleanupRound()
	if roundFolder then roundFolder:Destroy() end
	roundFolder = nil
	currentMap = nil
	extractionOpen = false
	monsterTraps = {}
	portals = {}
end

local function checkEnd()
	if State:GetAttribute("State") ~= "Hunt" then return false end
	if #survivors(true) == 0 or #monsters() == 0 then return true end
	return false
end

local function catchSurvivor(victim, monster)
	if not isHunting(victim) then return end
	victim:SetAttribute("Alive", false)
	local kind = monster and monster:GetAttribute("Monster") or ""
	local mname = Config.MONSTERS[kind] and Config.MONSTERS[kind].name or "the dark"
	Notify:FireClient(victim, "jumpscare", kind)
	toast(nil, ("%s was caught by %s!"):format(victim.DisplayName, mname))
	if monster then monster:SetAttribute("Catches", (monster:GetAttribute("Catches") or 0) + 1) end
	task.delay(2.2, function()
		if victim.Parent then sendToLobby(victim) end
	end)
end

local function escapeSurvivor(s)
	if not isHunting(s) then return end
	s:SetAttribute("Escaped", true)
	toast(nil, s.DisplayName .. " escaped on the helicopter!")
	Notify:FireClient(s, "escaped")
	sendToLobby(s)
end

local function openExtraction()
	if extractionOpen or not currentMap then return end
	extractionOpen = true
	local heli = Models.helicopter(CFrame.new(currentMap.extract + Vector3.new(0, 0.6, 0)), Color3.fromRGB(150, 140, 40))
	heli.Name = "ExtractionHelicopter"
	heli.Parent = roundFolder
	local beacon = Instance.new("Part")
	beacon.Name = "ExtractBeacon"
	beacon.Anchored = true
	beacon.CanCollide = false
	beacon.Material = Enum.Material.Neon
	beacon.Color = Color3.fromRGB(80, 255, 120)
	beacon.Transparency = 0.6
	beacon.Size = Vector3.new(3, 200, 3)
	beacon.CFrame = CFrame.new(currentMap.extract + Vector3.new(0, 100, 0))
	beacon.Parent = roundFolder
	setState("ExtractX", currentMap.extract.X)
	setState("ExtractZ", currentMap.extract.Z)
	setState("ExtractOpen", true)
	toast(nil, "The extraction helicopter has landed! Follow the green beam!")
end

local function pickRoles(list)
	local n = #list
	local cap = math.max(1, math.floor(n / 3))
	local shuffled = table.clone(list)
	for i = #shuffled, 2, -1 do
		local j = math.random(1, i)
		shuffled[i], shuffled[j] = shuffled[j], shuffled[i]
	end
	local chosen = {}
	for _, p in ipairs(shuffled) do
		if #chosen < cap and math.random() < Config.MONSTER_CHANCE then table.insert(chosen, p) end
	end
	if #chosen == 0 then table.insert(chosen, shuffled[1]) end
	if n == 1 and math.random() < 0.5 then chosen = {} end -- solo Studio test: 50/50 role
	local isMonster = {}
	for _, p in ipairs(chosen) do isMonster[p] = true end
	return isMonster
end

local function placeInMap(p)
	if not currentMap then return end
	local c = p.Character
	if not c then return end
	local role = p:GetAttribute("Role")
	if role == "Monster" then
		local sp = currentMap.monsterSpawns[math.random(1, #currentMap.monsterSpawns)]
		c:PivotTo(CFrame.lookAt(sp, Config.MAP_ORIGIN + Vector3.new(0, 4, 0)))
		Models.morph(c, p:GetAttribute("Monster"))
	else
		local sp = currentMap.spawns[math.random(1, #currentMap.spawns)]
		c:PivotTo(CFrame.new(sp))
		giveFlashlight(p)
	end
end

local function endRound(reason)
	if State:GetAttribute("State") ~= "Hunt" then return end
	roundToken += 1
	local token = roundToken
	setState("State", "Results")
	setState("ExtractOpen", false)
	local escaped, survived, caught = {}, {}, {}
	for _, s in ipairs(survivors(false)) do
		if s:GetAttribute("Escaped") then table.insert(escaped, s.DisplayName)
		elseif s:GetAttribute("Alive") then table.insert(survived, s.DisplayName)
		else table.insert(caught, s.DisplayName) end
	end
	local headline
	if #escaped + #survived > 0 then headline = "SURVIVORS WIN" else headline = "MONSTERS WIN" end
	local lines = {}
	if reason then table.insert(lines, reason) end
	if #escaped > 0 then table.insert(lines, "Escaped: " .. table.concat(escaped, ", ")) end
	if #survived > 0 then table.insert(lines, "Survived the night: " .. table.concat(survived, ", ")) end
	if #caught > 0 then table.insert(lines, "Caught: " .. table.concat(caught, ", ")) end
	for _, m in ipairs(monsters()) do
		local def = Config.MONSTERS[m:GetAttribute("Monster")]
		table.insert(lines, ("%s was %s (%d catches)"):format(m.DisplayName, def and def.name or "?", m:GetAttribute("Catches") or 0))
	end
	Notify:FireAllClients("results", headline, lines)
	setState("TimeLeft", Config.RESULTS_TIME)
	task.delay(Config.RESULTS_TIME, function()
		if token ~= roundToken then return end
		cleanupRound()
		for _, p in ipairs(Players:GetPlayers()) do
			resetPlayer(p)
			p:SetAttribute("Catches", 0)
			task.spawn(function() p:LoadCharacter() end)
		end
		setState("Theme", "")
		setState("TimeLeft", 0)
		setState("State", "Lobby")
		updateRegistry()
	end)
end

local function startRound(starter)
	if State:GetAttribute("State") ~= "Lobby" then return end
	local list = Players:GetPlayers()
	local minNeeded = CAN_TELEPORT and Config.MIN_PLAYERS or 1
	if #list < minNeeded then toast(starter, ("Need at least %d players to take off."):format(Config.MIN_PLAYERS)); return end
	for _, p in ipairs(list) do
		if not inPad(p.Character) then toast(starter, p.DisplayName .. " hasn't boarded the helicopter yet."); return end
	end
	roundToken += 1
	local token = roundToken
	cleanupRound()
	local theme = Config.THEMES[math.random(1, #Config.THEMES)]
	setState("Theme", theme)
	setState("State", "Flight")
	setState("TimeLeft", Config.FLIGHT_TIME)
	setState("ExtractOpen", false)
	roundFolder = Instance.new("Folder")
	roundFolder.Name = "Round"
	currentMap = MapGen.generate(theme, math.random(1, 1e9))
	currentMap.model.Parent = roundFolder
	setState("FogEnd", currentMap.fog)
	setState("FogColor", currentMap.fogColor)
	roundFolder.Parent = workspace

	local isMonster = pickRoles(list)
	local kinds = table.clone(Config.MONSTER_KEYS)
	for _, p in ipairs(list) do
		resetPlayer(p)
		p:SetAttribute("Catches", 0)
		if isMonster[p] then
			local k = table.remove(kinds, math.random(1, #kinds))
			p:SetAttribute("Role", "Monster")
			p:SetAttribute("Monster", k)
			cooldowns[p] = now() + Config.FLIGHT_TIME + 5
			p:SetAttribute("AbilityReadyAt", workspace:GetServerTimeNow() + Config.FLIGHT_TIME + 5)
		else
			p:SetAttribute("Role", "Survivor")
		end
	end
	Notify:FireAllClients("flight", theme)
	updateRegistry()

	task.delay(Config.FLIGHT_TIME, function()
		if token ~= roundToken then return end
		for _, p in ipairs(Players:GetPlayers()) do
			if p:GetAttribute("Role") ~= "" then placeInMap(p) end
		end
		setState("State", "Hunt")
		setState("TimeLeft", Config.ROUND_TIME)
		toast(nil, "Survive until the extraction helicopter arrives!")
		-- countdown
		task.spawn(function()
			while token == roundToken and State:GetAttribute("State") == "Hunt" do
				task.wait(1)
				if token ~= roundToken or State:GetAttribute("State") ~= "Hunt" then break end
				local t = State:GetAttribute("TimeLeft") - 1
				setState("TimeLeft", t)
				if t == Config.EXTRACT_AT then openExtraction() end
				if t <= 0 then endRound("Dawn breaks - time is up."); break end
			end
		end)
	end)
end

---------------------------------------------------------------------------
-- Simulation loop: speeds, stamina, catches, traps, extraction, boarding
---------------------------------------------------------------------------
local acc = 0
RunService.Heartbeat:Connect(function(dt)
	acc += dt
	if acc < 0.1 then return end
	local step = acc
	acc = 0
	local st = State:GetAttribute("State")
	local t = now()
	for _, p in ipairs(Players:GetPlayers()) do
		local hum, hrp = humOf(p), hrpOf(p)
		if hum and hrp then
			local f = F(p)
			local speed = Config.SURVIVOR_SPEED
			local canSprint = true
			local frozen = false
			if st == "Hunt" and p:GetAttribute("Role") == "Monster" and isHunting(p) then
				local def = Config.MONSTERS[p:GetAttribute("Monster")]
				speed = def and def.speed or 19
				if f.dashUntil and t < f.dashUntil then speed *= 2.6 end
				canSprint = false
			elseif st == "Hunt" and isHunting(p) then
				if f.greyUntil and t < f.greyUntil then canSprint = false end
				if f.slowUntil and t < f.slowUntil then speed *= 0.5 end
				if (f.stunUntil and t < f.stunUntil) or (f.rootUntil and t < f.rootUntil) then frozen = true end
			end
			local moving = hum.MoveDirection.Magnitude > 0.1
			if f.sprint and canSprint and moving and f.stamina > 0 and not frozen then
				speed *= Config.SPRINT_MULT
				f.stamina = math.max(0, f.stamina - 30 * step)
			else
				f.stamina = math.min(100, f.stamina + 14 * step)
			end
			if frozen then speed = 0 end
			if hum.WalkSpeed ~= speed then hum.WalkSpeed = speed end
			if hum.UseJumpPower then
				local jp = frozen and 0 or 50
				if hum.JumpPower ~= jp then hum.JumpPower = jp end
			else
				local jh = frozen and 0 or 7.2
				if hum.JumpHeight ~= jh then hum.JumpHeight = jh end
			end
			local stam = math.floor(f.stamina)
			if p:GetAttribute("Stamina") ~= stam then p:SetAttribute("Stamina", stam) end
			p:SetAttribute("CanSprint", canSprint)
			if st == "Lobby" then
				local b = inPad(p.Character)
				if p:GetAttribute("Boarded") ~= b then p:SetAttribute("Boarded", b) end
			end
		end
	end

	if st ~= "Hunt" then return end
	-- catches
	for _, m in ipairs(monsters()) do
		local mh = hrpOf(m)
		if mh and isHunting(m) then
			local f = F(m)
			local reach = Config.CATCH_REACH * ((f.reachUntil and t < f.reachUntil) and 3 or 1)
			for _, s in ipairs(survivors(true)) do
				local sh = hrpOf(s)
				if sh and (sh.Position - mh.Position).Magnitude <= reach then catchSurvivor(s, m) end
			end
		end
	end
	-- cupcake traps
	for owner, traps in pairs(monsterTraps) do
		for i = #traps, 1, -1 do
			local trap = traps[i]
			for _, s in ipairs(survivors(true)) do
				local sh = hrpOf(s)
				if trap.Parent and sh and (Vector3.new(sh.Position.X, 0, sh.Position.Z) - Vector3.new(trap.Position.X, 0, trap.Position.Z)).Magnitude < 3.5 and math.abs(sh.Position.Y - trap.Position.Y) < 6 then
					F(s).rootUntil = t + 2.2
					toast(s, "You stepped in a cupcake trap!")
					toast(owner, s.DisplayName .. " is stuck in your cupcake trap!")
					trap:Destroy()
					table.remove(traps, i)
					break
				end
			end
		end
	end
	-- extraction
	if extractionOpen and currentMap then
		for _, s in ipairs(survivors(true)) do
			local sh = hrpOf(s)
			if sh and (Vector3.new(sh.Position.X, 0, sh.Position.Z) - Vector3.new(currentMap.extract.X, 0, currentMap.extract.Z)).Magnitude < 15 then
				escapeSurvivor(s)
			end
		end
	end
	if checkEnd() then
		if #monsters() == 0 then endRound("All monsters left the game.")
		elseif #survivors(true) == 0 then endRound(nil) end
	end
end)

---------------------------------------------------------------------------
-- Players
---------------------------------------------------------------------------
local function pickNewHost()
	local list = Players:GetPlayers()
	table.sort(list, function(a, b) return (a:GetAttribute("JoinOrder") or 0) < (b:GetAttribute("JoinOrder") or 0) end)
	local h = list[1]
	settings.hostId = h and h.UserId or 0
	publishSettings()
	if h then toast(nil, h.DisplayName .. " is now the host.") end
end

local joinCounter = 0
local function hubAutoJoin(p) end -- defined below (forward)

local function onPlayerAdded(p)
	joinCounter += 1
	p:SetAttribute("JoinOrder", joinCounter)
	resetPlayer(p)
	p:SetAttribute("Catches", 0)
	p:SetAttribute("Boarded", false)

	if State:GetAttribute("Mode") == "Match" then
		local jd = p:GetJoinData()
		local td = jd and jd.TeleportData
		if settings.code == "" and type(td) == "table" and type(td.code) == "string" then
			settings.code = td.code:sub(1, 8)
			settings.name = tostring(td.name or "Night Hunt"):sub(1, 40)
			settings.max = clampMax(td.max)
			settings.public = td.public == true
			settings.hostId = tonumber(td.hostId) or p.UserId
			publishSettings()
		end
		if settings.hostId == 0 then settings.hostId = p.UserId; publishSettings() end
		if #Players:GetPlayers() > settings.max then
			p:Kick(("This Night Hunt server is full (%d/%d)."):format(settings.max, settings.max))
			return
		end
		if State:GetAttribute("State") ~= "Lobby" then
			p:SetAttribute("Role", "Spectator")
			toast(p, "A round is in progress - wait in the lobby for the next one.")
		end
		updateRegistry()
	else
		task.delay(3, function() hubAutoJoin(p) end)
	end

	p.CharacterAdded:Connect(function(char)
		local hum = char:WaitForChild("Humanoid", 10)
		if not hum then return end
		hum.Died:Connect(function()
			if State:GetAttribute("State") == "Hunt" and p:GetAttribute("Role") == "Survivor" and isHunting(p) then
				catchSurvivor(p, nil)
			end
		end)
		-- a monster that died (e.g. fell) respawns back into the hunt
		if State:GetAttribute("State") == "Hunt" and p:GetAttribute("Role") == "Monster" then
			task.wait(0.3)
			placeInMap(p)
		end
	end)
end
Players.PlayerAdded:Connect(onPlayerAdded)
for _, p in ipairs(Players:GetPlayers()) do task.spawn(onPlayerAdded, p) end

Players.PlayerRemoving:Connect(function(p)
	fx[p] = nil
	cooldowns[p] = nil
	if monsterTraps[p] then for _, tr in ipairs(monsterTraps[p]) do tr:Destroy() end end
	monsterTraps[p] = nil
	if portals[p] then portals[p]:Destroy() end
	portals[p] = nil
	task.defer(function()
		if State:GetAttribute("Mode") == "Match" and p.UserId == settings.hostId then pickNewHost() end
		updateRegistry()
	end)
end)

---------------------------------------------------------------------------
-- Client actions
---------------------------------------------------------------------------
Action.OnServerEvent:Connect(function(p, kind, data)
	if kind == "ability" then
		useAbility(p)
	elseif kind == "sprint" then
		F(p).sprint = data == true
	elseif kind == "start" then
		if State:GetAttribute("Mode") ~= "Match" then return end
		if p.UserId ~= settings.hostId then toast(p, "Only the host can take off."); return end
		startRound(p)
	elseif kind == "settings" then
		if State:GetAttribute("Mode") ~= "Match" or p.UserId ~= settings.hostId or type(data) ~= "table" then return end
		if data.max ~= nil then
			local m = clampMax(data.max)
			if m < #Players:GetPlayers() then toast(p, "There are already more players than that."); return end
			settings.max = m
		end
		if data.public ~= nil then settings.public = data.public == true end
		publishSettings()
		updateRegistry()
	end
end)

---------------------------------------------------------------------------
-- Hub: create / join / list
---------------------------------------------------------------------------
local lastHubCall = {}
local function teleportTo(p, access, entry)
	local opts = Instance.new("TeleportOptions")
	opts.ReservedServerAccessCode = access
	opts:SetTeleportData({ code = entry.code, name = entry.name, max = entry.max, public = entry.public, hostId = entry.hostId })
	local ok, err = pcall(function() TeleportService:TeleportAsync(game.PlaceId, { p }, opts) end)
	if not ok then return false, "Teleport failed: " .. tostring(err) end
	return true
end

local function hubCreate(p, data)
	data = type(data) == "table" and data or {}
	local entryName = filterName(data.name, p)
	local max = clampMax(data.max)
	local public = data.public == true
	if not CAN_TELEPORT then
		-- Studio / unpublished place: turn this server into the match so it can be tested.
		setState("Mode", "Match")
		settings.code = "STUDIO"
		settings.name = entryName
		settings.max = max
		settings.public = public
		settings.hostId = p.UserId
		publishSettings()
		return { ok = true, local_ = true, msg = "Studio test: this server is now your match. Board the helicopter and press Take off." }
	end
	if not registry then return { ok = false, msg = "Server list unavailable (enable API Services)." } end
	local code
	for _ = 1, 6 do
		local c = newCode()
		local ok, existing = pcall(function() return registry:GetAsync(c) end)
		if ok and existing == nil then code = c; break end
	end
	if not code then return { ok = false, msg = "Couldn't make a code, try again." } end
	local okR, access = pcall(function() return TeleportService:ReserveServer(game.PlaceId) end)
	if not okR then return { ok = false, msg = "Couldn't reserve a server: " .. tostring(access) } end
	local entry = { code = code, name = entryName, max = max, public = public, host = p.DisplayName, hostId = p.UserId,
		players = 0, state = "Lobby", updated = os.time(), access = access }
	local okS, errS = pcall(function() registry:SetAsync(code, entry, 300) end)
	if not okS then return { ok = false, msg = "Couldn't save the server: " .. tostring(errS) } end
	local okT, errT = teleportTo(p, access, entry)
	if not okT then return { ok = false, msg = errT } end
	return { ok = true, code = code, msg = "Server " .. code .. " created - flying you there..." }
end

local function hubJoin(p, code)
	code = tostring(code or ""):upper():gsub("[^A-Z0-9]", "")
	if #code < 4 then return { ok = false, msg = "Enter a server code." } end
	if not CAN_TELEPORT then return { ok = false, msg = "Joining by code only works in the published game (not in Studio)." } end
	if not registry then return { ok = false, msg = "Server list unavailable." } end
	local ok, entry = pcall(function() return registry:GetAsync(code) end)
	if not ok then return { ok = false, msg = "Lookup failed, try again." } end
	if not entry then return { ok = false, msg = "No server with code " .. code .. "." } end
	if (entry.players or 0) >= (entry.max or Config.MAX_PLAYERS) then
		return { ok = false, msg = ("Server is full (%d/%d)."):format(entry.players or 0, entry.max or 0) }
	end
	local okT, errT = teleportTo(p, entry.access, entry)
	if not okT then return { ok = false, msg = errT } end
	return { ok = true, msg = "Joining " .. tostring(entry.name) .. "..." }
end

local function hubList()
	if not registry or not CAN_TELEPORT then return { ok = true, servers = {} } end
	local ok, items = pcall(function() return registry:GetRangeAsync(Enum.SortDirection.Descending, 100) end)
	if not ok then return { ok = false, servers = {}, msg = "Couldn't load servers." } end
	local list = {}
	for _, it in ipairs(items) do
		local v = it.value
		if type(v) == "table" and v.public and (v.players or 0) > 0 and os.time() - (v.updated or 0) < 90 then
			table.insert(list, { code = it.key, name = v.name, host = v.host, players = v.players, max = v.max, state = v.state })
		end
	end
	table.sort(list, function(a, b) return a.players > b.players end)
	return { ok = true, servers = list }
end

Hub.OnServerInvoke = function(p, kind, data)
	if State:GetAttribute("Mode") ~= "Hub" then return { ok = false, msg = "You're already in a match server." } end
	if kind == "list" then return hubList() end
	local t = os.clock()
	if lastHubCall[p] and t - lastHubCall[p] < 2 then return { ok = false, msg = "Slow down a moment." } end
	lastHubCall[p] = t
	if kind == "create" then return hubCreate(p, data) end
	if kind == "join" then return hubJoin(p, data) end
	return { ok = false, msg = "Unknown request." }
end

-- Invites carry the server code as LaunchData; hub servers auto-join it.
hubAutoJoin = function(p)
	if not p.Parent or State:GetAttribute("Mode") ~= "Hub" then return end
	local jd = p:GetJoinData()
	local code = jd and jd.LaunchData
	if type(code) == "string" and code:match("^[A-Z0-9]+$") and #code <= 8 then
		toast(p, "Invite found - joining server " .. code .. "...")
		local res = hubJoin(p, code)
		if not res.ok then toast(p, res.msg) end
	end
end

TeleportService.TeleportInitFailed:Connect(function(p, _result, msg)
	toast(p, "Teleport failed: " .. tostring(msg))
end)

---------------------------------------------------------------------------
-- Registry heartbeat + shutdown
---------------------------------------------------------------------------
task.spawn(function()
	while true do
		task.wait(15)
		if State:GetAttribute("Mode") == "Match" then updateRegistry() end
	end
end)

game:BindToClose(function()
	if registry and settings.code ~= "" and CAN_TELEPORT then
		pcall(function() registry:RemoveAsync(settings.code) end)
	end
end)
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">MapGen</string>
          <string name="Source"><![CDATA[-- Generates one of three themed hunt maps out of anchored parts.
local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("NightHunt"):WaitForChild("Config"))

local MapGen = {}

local function part(parent, size, cf, color, mat, opts)
	opts = opts or {}
	local p = Instance.new("Part")
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = mat or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if opts.shape then p.Shape = opts.shape end
	if opts.collide ~= nil then p.CanCollide = opts.collide end
	if opts.transp then p.Transparency = opts.transp end
	p.Name = opts.name or "Part"
	p.Parent = parent
	return p
end

local THEME = {
	["Abandoned Pizzeria Town"] = {
		ground = Color3.fromRGB(45, 42, 40), groundMat = Enum.Material.Asphalt,
		wall = Color3.fromRGB(110, 70, 60), wallMat = Enum.Material.Brick,
		floor = Color3.fromRGB(30, 30, 30), floorMat = Enum.Material.Slate,
		buildings = 11, trees = 10, hides = 14, fog = 140,
		lamp = Color3.fromRGB(255, 190, 110), fogColor = Color3.fromRGB(20, 14, 14),
	},
	["Foggy Woods"] = {
		ground = Color3.fromRGB(38, 54, 32), groundMat = Enum.Material.Grass,
		wall = Color3.fromRGB(92, 70, 50), wallMat = Enum.Material.WoodPlanks,
		floor = Color3.fromRGB(70, 52, 36), floorMat = Enum.Material.Wood,
		buildings = 4, trees = 90, hides = 26, fog = 90,
		lamp = Color3.fromRGB(255, 170, 90), fogColor = Color3.fromRGB(26, 32, 30),
	},
	["Static Fields"] = {
		ground = Color3.fromRGB(70, 70, 54), groundMat = Enum.Material.Grass,
		wall = Color3.fromRGB(130, 130, 130), wallMat = Enum.Material.Concrete,
		floor = Color3.fromRGB(60, 60, 60), floorMat = Enum.Material.Concrete,
		buildings = 6, trees = 24, hides = 30, fog = 120,
		lamp = Color3.fromRGB(200, 220, 255), fogColor = Color3.fromRGB(30, 30, 34),
	},
}
MapGen.THEME = THEME

-- A box building with walls, a roof, and a doorway on one random side.
local function building(parent, t, center, w, d, rng)
	local h = 14
	local wallT = 1
	local doorW = 7
	local doorSide = rng:NextInteger(1, 4)
	local b = Instance.new("Model")
	b.Name = "Building"
	b.Parent = parent
	part(b, Vector3.new(w, 0.4, d), CFrame.new(center + Vector3.new(0, 0.2, 0)), t.floor, t.floorMat)
	part(b, Vector3.new(w + 2, 1, d + 2), CFrame.new(center + Vector3.new(0, h + 0.5, 0)), t.wall, t.wallMat)
	local sides = {
		{ len = w, cf = CFrame.new(center + Vector3.new(0, h / 2, -d / 2)), axis = "x" },
		{ len = w, cf = CFrame.new(center + Vector3.new(0, h / 2, d / 2)), axis = "x" },
		{ len = d, cf = CFrame.new(center + Vector3.new(-w / 2, h / 2, 0)), axis = "z" },
		{ len = d, cf = CFrame.new(center + Vector3.new(w / 2, h / 2, 0)), axis = "z" },
	}
	for i, s in ipairs(sides) do
		local function seg(len, offset)
			if len <= 0.1 then return end
			local size = s.axis == "x" and Vector3.new(len, h, wallT) or Vector3.new(wallT, h, len)
			local shift = s.axis == "x" and Vector3.new(offset, 0, 0) or Vector3.new(0, 0, offset)
			part(b, size, s.cf + shift, t.wall, t.wallMat)
		end
		if i == doorSide then
			local half = (s.len - doorW) / 2
			seg(half, -(doorW / 2 + half / 2))
			seg(half, doorW / 2 + half / 2)
			local lintel = s.axis == "x" and Vector3.new(doorW, 4, wallT) or Vector3.new(wallT, 4, doorW)
			part(b, lintel, s.cf + Vector3.new(0, h / 2 - 2, 0), t.wall, t.wallMat)
		else
			seg(s.len, 0)
		end
	end
	-- a flickering ceiling light
	local bulb = part(b, Vector3.new(1, 0.5, 1), CFrame.new(center + Vector3.new(0, h - 0.4, 0)), t.lamp, Enum.Material.Neon, { collide = false, name = "FlickerLight" })
	local l = Instance.new("PointLight")
	l.Range = 22
	l.Brightness = 1.4
	l.Color = t.lamp
	l.Parent = bulb
	-- a table inside to break line of sight
	part(b, Vector3.new(6, 3, 3), CFrame.new(center + Vector3.new(rng:NextNumber(-w / 4, w / 4), 1.5, rng:NextNumber(-d / 4, d / 4))), Color3.fromRGB(60, 45, 35), Enum.Material.Wood)
	return b
end

local function tree(parent, pos, theme, rng)
	local tm = Instance.new("Model")
	tm.Name = "Tree"
	tm.Parent = parent
	local h = rng:NextNumber(18, 34)
	part(tm, Vector3.new(2.2, h, 2.2), CFrame.new(pos + Vector3.new(0, h / 2, 0)), Color3.fromRGB(58, 42, 30), Enum.Material.Wood)
	if theme ~= "Static Fields" then
		local leaf = theme == "Foggy Woods" and Color3.fromRGB(28, 48, 28) or Color3.fromRGB(40, 50, 30)
		part(tm, Vector3.new(12, 12, 12), CFrame.new(pos + Vector3.new(0, h, 0)), leaf, Enum.Material.Grass, { shape = Enum.PartType.Ball, collide = false })
	else
		-- dead tree: a few bare branches
		for i = 1, 3 do
			part(tm, Vector3.new(0.7, 7, 0.7), CFrame.new(pos + Vector3.new(0, h * 0.7 + i * 2, 0)) * CFrame.Angles(0, math.rad(i * 120), math.rad(40)), Color3.fromRGB(58, 42, 30), Enum.Material.Wood)
		end
	end
end

-- Generate a map. Returns info { model, spawns, vents, extract, theme, half }.
function MapGen.generate(themeName, seed)
	local rng = Random.new(seed or os.time())
	local t = THEME[themeName] or THEME["Foggy Woods"]
	local O = Config.MAP_ORIGIN
	local S = Config.MAP_SIZE
	local half = S / 2
	local map = Instance.new("Model")
	map.Name = "NightHuntMap"

	part(map, Vector3.new(S + 20, 2, S + 20), CFrame.new(O + Vector3.new(0, -1, 0)), t.ground, t.groundMat, { name = "Ground" })
	for _, w in ipairs({
		{ Vector3.new(S + 20, 40, 2), Vector3.new(0, 20, -half - 10) },
		{ Vector3.new(S + 20, 40, 2), Vector3.new(0, 20, half + 10) },
		{ Vector3.new(2, 40, S + 20), Vector3.new(-half - 10, 20, 0) },
		{ Vector3.new(2, 40, S + 20), Vector3.new(half + 10, 20, 0) },
	}) do
		part(map, w[1], CFrame.new(O + w[2]), Color3.fromRGB(10, 10, 12), Enum.Material.Slate, { name = "Boundary", transp = 0.2 })
	end

	local occupied = {}
	local function free(pos, r)
		for _, o in ipairs(occupied) do
			if (Vector2.new(o.p.X, o.p.Z) - Vector2.new(pos.X, pos.Z)).Magnitude < r + o.r then return false end
		end
		return true
	end
	local function claim(pos, r) table.insert(occupied, { p = pos, r = r }) end
	local function randPos(margin)
		return O + Vector3.new(rng:NextNumber(-half + margin, half - margin), 0, rng:NextNumber(-half + margin, half - margin))
	end

	-- extraction pad (kept clear) in a random corner region
	local ex = O + Vector3.new((rng:NextInteger(0, 1) * 2 - 1) * (half - 40), 0, (rng:NextInteger(0, 1) * 2 - 1) * (half - 40))
	claim(ex, 26)
	local pad = part(map, Vector3.new(30, 0.4, 30), CFrame.new(ex + Vector3.new(0, 0.2, 0)), Color3.fromRGB(50, 50, 50), Enum.Material.Concrete, { name = "ExtractPad" })
	part(map, Vector3.new(16, 0.45, 2), CFrame.new(ex + Vector3.new(0, 0.25, 0)), Color3.fromRGB(240, 240, 240), Enum.Material.Neon)
	part(map, Vector3.new(2, 0.45, 16), CFrame.new(ex + Vector3.new(-7, 0.25, 0)), Color3.fromRGB(240, 240, 240), Enum.Material.Neon)
	part(map, Vector3.new(2, 0.45, 16), CFrame.new(ex + Vector3.new(7, 0.25, 0)), Color3.fromRGB(240, 240, 240), Enum.Material.Neon)
	_ = pad

	-- central spawn plaza kept clear
	claim(O, 30)

	for _ = 1, t.buildings do
		for _try = 1, 25 do
			local w, d = rng:NextInteger(24, 44), rng:NextInteger(22, 40)
			local pos = randPos(30)
			local r = math.max(w, d) / 2 + 8
			if free(pos, r) then
				claim(pos, r)
				building(map, t, pos, w, d, rng)
				break
			end
		end
	end

	for _ = 1, t.trees do
		for _try = 1, 10 do
			local pos = randPos(6)
			if free(pos, 5) then
				claim(pos, 3)
				tree(map, pos, themeName, rng)
				break
			end
		end
	end

	-- hiding bushes / crates (walk inside them to hide)
	for _ = 1, t.hides do
		for _try = 1, 10 do
			local pos = randPos(8)
			if free(pos, 5) then
				claim(pos, 4)
				if themeName == "Abandoned Pizzeria Town" then
					local c = part(map, Vector3.new(7, 7, 7), CFrame.new(pos + Vector3.new(0, 3.5, 0)), Color3.fromRGB(120, 90, 50), Enum.Material.WoodPlanks, { collide = false, name = "HideSpot", transp = 0.05 })
					_ = c
				else
					part(map, Vector3.new(9, 8, 9), CFrame.new(pos + Vector3.new(0, 3, 0)), themeName == "Foggy Woods" and Color3.fromRGB(30, 60, 30) or Color3.fromRGB(95, 95, 60), Enum.Material.Grass, { shape = Enum.PartType.Ball, collide = false, name = "HideSpot" })
				end
				break
			end
		end
	end

	-- street lamps / static pylons
	for _ = 1, 14 do
		local pos = randPos(10)
		if free(pos, 3) then
			claim(pos, 2)
			part(map, Vector3.new(0.8, 16, 0.8), CFrame.new(pos + Vector3.new(0, 8, 0)), Color3.fromRGB(40, 40, 40), Enum.Material.Metal)
			local bulb = part(map, Vector3.new(1.6, 1, 1.6), CFrame.new(pos + Vector3.new(0, 16.4, 0)), t.lamp, Enum.Material.Neon, { collide = false, name = "FlickerLight" })
			local l = Instance.new("PointLight")
			l.Range = 30
			l.Brightness = 1.2
			l.Color = t.lamp
			l.Parent = bulb
		end
	end

	-- vents (Springtrap teleports between these)
	local vents = {}
	for i = 1, 8 do
		for _try = 1, 15 do
			local pos = randPos(14)
			if free(pos, 3) then
				claim(pos, 2)
				part(map, Vector3.new(5, 0.3, 5), CFrame.new(pos + Vector3.new(0, 0.15, 0)), Color3.fromRGB(80, 85, 90), Enum.Material.DiamondPlate, { name = "Vent" .. i })
				table.insert(vents, pos + Vector3.new(0, 3, 0))
				break
			end
		end
	end

	-- survivor spawns around the plaza, monster spawns on the far side
	local spawns, monsterSpawns = {}, {}
	for i = 1, 15 do
		local a = (i / 15) * math.pi * 2
		table.insert(spawns, O + Vector3.new(math.cos(a) * 14, 4, math.sin(a) * 14))
	end
	for i = 1, 5 do
		local a = rng:NextNumber(0, math.pi * 2)
		table.insert(monsterSpawns, O + Vector3.new(math.cos(a) * (half - 25), 4, math.sin(a) * (half - 25)))
	end

	return {
		model = map, spawns = spawns, monsterSpawns = monsterSpawns, vents = vents,
		extract = ex, theme = themeName, half = half, fog = t.fog, fogColor = t.fogColor,
	}
end

return MapGen
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Models</string>
          <string name="Source"><![CDATA[-- Part-built models: the 12 monsters (welded onto a player's character) and helicopters.
local Models = {}

local function rgb(r, g, b) return Color3.fromRGB(r, g, b) end
local function at(x, y, z, rx, ry, rz)
	return CFrame.new(x, y, z) * CFrame.Angles(math.rad(rx or 0), math.rad(ry or 0), math.rad(rz or 0))
end
local BALL, CYL = Enum.PartType.Ball, Enum.PartType.Cylinder
local NEON, METAL, GLASS = Enum.Material.Neon, Enum.Material.Metal, Enum.Material.Glass

-- Builder: adds parts relative to `root`. If anchored, parts are anchored; otherwise welded to root.
local function builder(model, root, anchored)
	return function(size, off, color, opts)
		opts = opts or {}
		local p = Instance.new("Part")
		p.Size = size
		p.Color = color
		p.Material = opts.mat or Enum.Material.SmoothPlastic
		if opts.shape then p.Shape = opts.shape end
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.CastShadow = false
		p.CanCollide = anchored and (opts.collide == true) or false
		p.CanQuery = anchored
		p.CanTouch = false
		p.Massless = true
		p.Anchored = anchored
		p.Transparency = opts.transp or 0
		p.CFrame = root.CFrame * off
		p.Name = opts.name or "Part"
		if not anchored then
			local w = Instance.new("WeldConstraint")
			w.Part0 = root
			w.Part1 = p
			w.Parent = p
		end
		p.Parent = model
		return p
	end
end

local function eyes(P, y, z, sp, size, white, pupil, pupilColor, glow)
	if white then
		P(Vector3.new(size, size, size), at(-sp, y, z), rgb(255, 255, 255), { shape = BALL })
		P(Vector3.new(size, size, size), at(sp, y, z), rgb(255, 255, 255), { shape = BALL })
	end
	local m = glow and NEON or Enum.Material.SmoothPlastic
	P(Vector3.new(pupil, pupil, pupil), at(-sp, y, z - size * 0.42), pupilColor, { shape = BALL, mat = m })
	P(Vector3.new(pupil, pupil, pupil), at(sp, y, z - size * 0.42), pupilColor, { shape = BALL, mat = m })
end

local function humanoidBody(P, body, opts)
	opts = opts or {}
	local h = opts.height or 1
	P(Vector3.new(2.6, 3 * h, 1.6), at(0, 0.2 * h, 0), body)                                   -- torso
	P(Vector3.new(0.9, 2.2, 0.9), at(-0.65, -2, 0), opts.legs or body)                          -- legs
	P(Vector3.new(0.9, 2.2, 0.9), at(0.65, -2, 0), opts.legs or body)
	P(Vector3.new(0.75, 2.8 * h, 0.75), at(-1.7, 0.2, 0, 0, 0, -8), opts.arms or body)            -- arms
	P(Vector3.new(0.75, 2.8 * h, 0.75), at(1.7, 0.2, 0, 0, 0, 8), opts.arms or body)
end

local function animatronic(P, body, belly, eyeColor)
	humanoidBody(P, body)
	P(Vector3.new(1.9, 2, 0.3), at(0, -0.1, -0.85), belly)                                      -- belly
	P(Vector3.new(2.7, 2.7, 2.7), at(0, 2.7, 0), body, { shape = BALL })                         -- head
	P(Vector3.new(1.7, 0.9, 0.7), at(0, 2.2, -1.15), belly)                                     -- muzzle
	P(Vector3.new(1.3, 0.22, 0.1), at(0, 1.85, -1.5), rgb(235, 230, 215))                        -- teeth
	eyes(P, 3.05, -1.05, 0.5, 0.65, true, 0.32, eyeColor, true)
end

local BUILD = {}
BUILD.freddy = function(P)
	animatronic(P, rgb(122, 74, 34), rgb(200, 149, 93), rgb(30, 30, 30))
	P(Vector3.new(0.45, 0.45, 0.45), at(0, 2.5, -1.55), rgb(20, 20, 20), { shape = BALL })       -- nose
	P(Vector3.new(0.85, 0.85, 0.85), at(-1, 3.9, 0), rgb(122, 74, 34), { shape = BALL })         -- ears
	P(Vector3.new(0.85, 0.85, 0.85), at(1, 3.9, 0), rgb(122, 74, 34), { shape = BALL })
	P(Vector3.new(0.15, 1.9, 1.9), at(0, 4, 0, 0, 0, 90), rgb(15, 15, 15), { shape = CYL })     -- hat brim
	P(Vector3.new(1.1, 1.2, 1.2), at(0, 4.6, 0, 0, 0, 90), rgb(15, 15, 15), { shape = CYL })    -- hat
	P(Vector3.new(1.1, 0.45, 0.2), at(0, 1.4, -0.85), rgb(15, 15, 15))                          -- bow tie
end
BUILD.bonnie = function(P)
	animatronic(P, rgb(91, 91, 189), rgb(185, 167, 232), rgb(200, 40, 40))
	P(Vector3.new(0.45, 0.45, 0.45), at(0, 2.5, -1.55), rgb(20, 20, 20), { shape = BALL })
	P(Vector3.new(0.55, 2.6, 0.4), at(-0.55, 4.9, 0, 0, 0, 8), rgb(91, 91, 189))                -- tall ears
	P(Vector3.new(0.55, 2.6, 0.4), at(0.55, 4.9, 0, 0, 0, -8), rgb(91, 91, 189))
	P(Vector3.new(1.1, 0.45, 0.2), at(0, 1.4, -0.85), rgb(190, 30, 30))
	P(Vector3.new(3, 0.7, 0.25), at(0, 0, -1.2, 0, 0, 30), rgb(190, 30, 30))                    -- guitar
end
BUILD.chica = function(P)
	animatronic(P, rgb(241, 196, 15), rgb(247, 224, 138), rgb(142, 68, 173))
	P(Vector3.new(1.3, 0.5, 0.9), at(0, 2.35, -1.5), rgb(243, 156, 18))                         -- beak
	P(Vector3.new(0.2, 0.8, 0.2), at(0, 4.3, 0), rgb(241, 196, 15))                             -- feather tuft
	P(Vector3.new(2, 1.3, 0.12), at(0, 0.3, -1.02), rgb(255, 255, 255))                         -- bib
	P(Vector3.new(0.9, 0.9, 0.9), at(2.2, 0.6, -0.7), rgb(255, 122, 182), { shape = BALL })      -- cupcake
end
BUILD.foxy = function(P)
	animatronic(P, rgb(176, 58, 46), rgb(217, 140, 108), rgb(241, 196, 15))
	P(Vector3.new(0.45, 0.45, 0.45), at(0, 2.5, -1.55), rgb(20, 20, 20), { shape = BALL })
	P(Vector3.new(0.6, 1.3, 0.35), at(-0.85, 4.1, 0, 0, 0, 15), rgb(176, 58, 46))               -- pointy ears
	P(Vector3.new(0.6, 1.3, 0.35), at(0.85, 4.1, 0, 0, 0, -15), rgb(176, 58, 46))
	P(Vector3.new(0.85, 0.7, 0.12), at(0.5, 3.05, -1.4), rgb(15, 15, 15))                       -- eye patch
	P(Vector3.new(0.3, 1, 0.3), at(1.75, -1.6, -0.3, 0, 0, 20), rgb(190, 190, 190), { mat = METAL }) -- hook
	P(Vector3.new(0.5, 0.5, 3), at(0, -0.6, 1.6, -30, 0, 0), rgb(176, 58, 46))                  -- tail
end
BUILD.springtrap = function(P)
	animatronic(P, rgb(125, 140, 60), rgb(169, 168, 106), rgb(230, 230, 230))
	P(Vector3.new(0.45, 0.45, 0.45), at(0, 2.5, -1.55), rgb(60, 50, 30), { shape = BALL })
	P(Vector3.new(0.55, 2.4, 0.4), at(-0.5, 4.8, 0, 0, 0, 6), rgb(125, 140, 60))
	P(Vector3.new(0.55, 2.2, 0.4), at(1, 4.3, 0.2, 0, 0, -45), rgb(105, 120, 45))               -- bent ear
	P(Vector3.new(0.7, 0.7, 0.12), at(0.6, 0.6, -1.02), rgb(50, 35, 25))                        -- torn hole
	P(Vector3.new(0.6, 0.6, 0.12), at(-0.5, -0.6, -1.02), rgb(50, 35, 25))
end
BUILD.cartooncat = function(P)
	local black = rgb(15, 15, 15)
	P(Vector3.new(0.45, 3.4, 0.45), at(-0.5, -1.3, 0), black)                                    -- thin legs
	P(Vector3.new(0.45, 3.4, 0.45), at(0.5, -1.3, 0), black)
	P(Vector3.new(1.6, 3.4, 1.2), at(0, 2, 0), black)                                           -- torso
	P(Vector3.new(0.35, 5.4, 0.35), at(-2, 1.3, 0, 0, 0, -25), black)                            -- long arms
	P(Vector3.new(0.35, 5.4, 0.35), at(2, 1.3, 0, 0, 0, 25), black)
	P(Vector3.new(0.8, 0.8, 0.8), at(-3.1, -1.2, 0), rgb(255, 255, 255), { shape = BALL })       -- glove hands
	P(Vector3.new(0.8, 0.8, 0.8), at(3.1, -1.2, 0), rgb(255, 255, 255), { shape = BALL })
	P(Vector3.new(3.4, 3.4, 3.4), at(0, 5.2, 0), black, { shape = BALL })                        -- head
	P(Vector3.new(0.9, 1.5, 0.4), at(-1.1, 7, 0, 0, 0, 20), black)                               -- ears
	P(Vector3.new(0.9, 1.5, 0.4), at(1.1, 7, 0, 0, 0, -20), black)
	eyes(P, 5.7, -1.2, 0.7, 1.2, true, 0.45, black, false)
	P(Vector3.new(2.8, 0.7, 0.2), at(0, 4.5, -1.6), rgb(255, 255, 255))                          -- huge grin
	for i = -4, 4 do P(Vector3.new(0.08, 0.7, 0.22), at(i * 0.3, 4.5, -1.62), black) end          -- teeth lines
end
BUILD.sirenhead = function(P)
	local skin = rgb(107, 79, 58)
	P(Vector3.new(0.7, 7, 0.7), at(-0.6, 0.5, 0), skin)                                          -- very long legs
	P(Vector3.new(0.7, 7, 0.7), at(0.6, 0.5, 0), skin)
	P(Vector3.new(1.5, 5, 1), at(0, 6.5, 0), rgb(122, 92, 69))                                  -- thin torso
	P(Vector3.new(0.5, 7, 0.5), at(-1.5, 5.4, 0, 0, 0, -10), skin)                               -- arms
	P(Vector3.new(0.5, 7, 0.5), at(1.5, 5.4, 0, 0, 0, 10), skin)
	P(Vector3.new(3.5, 0.45, 0.45), at(0, 10.7, 0, 0, 0, 90), rgb(90, 90, 90), { shape = CYL, mat = METAL }) -- pole neck
	P(Vector3.new(4.4, 0.35, 0.35), at(0, 12.2, 0), rgb(90, 90, 90), { mat = METAL })            -- crossbar
	for _, x in ipairs({ -1.9, 1.9 }) do
		P(Vector3.new(1.7, 1.5, 1.3), at(x, 12.3, 0), rgb(140, 140, 140), { mat = METAL })        -- speakers
		P(Vector3.new(0.2, 1.1, 1.1), at(x, 12.3, -0.7, 0, 90, 0), rgb(20, 20, 20), { shape = CYL })
	end
end
BUILD.boiledone = function(P)
	local red = rgb(59, 8, 8)
	humanoidBody(P, red, { arms = rgb(45, 5, 5) })
	P(Vector3.new(2.5, 2.5, 2.5), at(0, 3.1, 0), rgb(74, 10, 10), { shape = BALL })
	eyes(P, 3.35, -1.05, 0.4, 0.3, false, 0.3, rgb(255, 255, 255), true)
	for i = 1, 6 do P(Vector3.new(0.35, 0.35, 0.35), at(math.sin(i * 7) * 1.1, math.cos(i * 3) * 1.4, -0.85), rgb(140, 0, 0), { shape = BALL, mat = NEON }) end
end
BUILD.drnowhere = function(P)
	humanoidBody(P, rgb(232, 232, 232), { legs = rgb(40, 40, 50) })
	P(Vector3.new(2.8, 1.6, 1.7), at(0, -1.2, 0), rgb(232, 232, 232))                           -- coat tail
	P(Vector3.new(0.35, 1.8, 0.1), at(0, 0.6, -0.82), rgb(20, 20, 20))                          -- tie
	P(Vector3.new(2.3, 2.3, 2.3), at(0, 2.9, 0), rgb(240, 230, 210), { shape = BALL })           -- pale head
	P(Vector3.new(0.65, 0.8, 0.4), at(-0.45, 3.1, -0.92), rgb(0, 0, 0), { shape = BALL })        -- hollow eyes
	P(Vector3.new(0.65, 0.8, 0.4), at(0.45, 3.1, -0.92), rgb(0, 0, 0), { shape = BALL })
	P(Vector3.new(1.2, 0.12, 0.1), at(0, 2.45, -1.08), rgb(0, 0, 0))                            -- thin smile
	P(Vector3.new(2.4, 0.25, 2.4), at(0, 3.75, 0), rgb(150, 150, 150))                          -- headband
	P(Vector3.new(0.12, 0.7, 0.7), at(0, 3.9, -1.15, 0, 90, 0), rgb(200, 40, 40), { shape = CYL, mat = METAL }) -- head mirror
end
BUILD.locust = function(P)
	local black = rgb(21, 21, 21)
	P(Vector3.new(0.5, 2.4, 0.5), at(-0.5, -1.9, 0), black)
	P(Vector3.new(0.5, 2.4, 0.5), at(0.5, -1.9, 0), black)
	P(Vector3.new(1.8, 4, 1.2), at(0, 0.9, 0), black)
	P(Vector3.new(2.1, 2.1, 2.1), at(0, 3.9, 0), rgb(28, 28, 28), { shape = BALL })
	eyes(P, 4.1, -0.9, 0.42, 0.45, false, 0.45, rgb(212, 255, 58), true)
	P(Vector3.new(0.12, 2.6, 0.12), at(-0.6, 5.8, 0, 0, 0, 25), black)                           -- antennae
	P(Vector3.new(0.12, 2.6, 0.12), at(0.6, 5.8, 0, 0, 0, -25), black)
	for i, y in ipairs({ 1.8, 0.8, -0.2 }) do                                                    -- insect arms
		P(Vector3.new(0.25, 2.6, 0.25), at(-1.6, y, 0, 0, 0, -60 + i * 10), black)
		P(Vector3.new(0.25, 2.6, 0.25), at(1.6, y, 0, 0, 0, 60 - i * 10), black)
	end
	for i = 1, 5 do P(Vector3.new(1.4, 0.06, 0.05), at(math.sin(i * 5) * 0.6, i * 0.8 - 1.5, -0.62), rgb(220, 220, 220), { mat = NEON, transp = 0.4 }) end -- static lines
end
BUILD.monochrome = function(P)
	humanoidBody(P, rgb(154, 154, 154), { legs = rgb(110, 110, 110), arms = rgb(190, 190, 190) })
	P(Vector3.new(0.9, 0.9, 0.12), at(-0.6, 0.6, -0.82), rgb(80, 80, 80))
	P(Vector3.new(0.9, 0.9, 0.12), at(0.5, -0.4, -0.82), rgb(220, 220, 220))
	P(Vector3.new(2.6, 2.6, 2.6), at(0, 3, 0), rgb(220, 220, 220))                              -- boxy white head
	P(Vector3.new(0.75, 0.9, 0.3), at(-0.55, 3.3, -1.25), rgb(0, 0, 0), { shape = BALL })
	P(Vector3.new(0.75, 0.9, 0.3), at(0.55, 3.3, -1.25), rgb(0, 0, 0), { shape = BALL })
	P(Vector3.new(1.6, 0.15, 0.1), at(0, 2.45, -1.32), rgb(0, 0, 0))
	P(Vector3.new(0.15, 0.4, 0.1), at(-0.8, 2.6, -1.32), rgb(0, 0, 0))
	P(Vector3.new(0.15, 0.4, 0.1), at(0.8, 2.6, -1.32), rgb(0, 0, 0))
end
BUILD.demogorgon = function(P)
	local skin = rgb(110, 93, 86)
	P(Vector3.new(0.75, 2.6, 0.75), at(-0.6, -1.7, 0), skin)
	P(Vector3.new(0.75, 2.6, 0.75), at(0.6, -1.7, 0), skin)
	P(Vector3.new(2, 3.6, 1.3), at(0, 1.2, 0), skin)
	P(Vector3.new(0.5, 4, 0.5), at(-1.5, 0.6, 0, 0, 0, -10), skin)
	P(Vector3.new(0.5, 4, 0.5), at(1.5, 0.6, 0, 0, 0, 10), skin)
	P(Vector3.new(1.5, 1.5, 1.5), at(0, 3.9, -0.2), rgb(90, 13, 13), { shape = BALL })           -- mouth center
	for i = 0, 4 do                                                                             -- five open petals
		local off = CFrame.new(0, 3.9, -0.4) * CFrame.Angles(0, 0, math.rad(i * 72)) * CFrame.new(0, 1.05, 0) * CFrame.Angles(math.rad(-35), 0, 0)
		P(Vector3.new(1, 2, 0.22), off, rgb(138, 112, 102))
		P(Vector3.new(0.8, 0.15, 0.26), off * CFrame.new(0, -0.6, -0.02), rgb(245, 240, 224))
		P(Vector3.new(0.8, 0.15, 0.26), off * CFrame.new(0, 0.1, -0.02), rgb(245, 240, 224))
	end
end

-- Weld a monster model onto a character. Returns the model.
function Models.morph(character, kind)
	local hrp = character:FindFirstChild("HumanoidRootPart")
	if not hrp then return nil end
	local old = character:FindFirstChild("NH_Morph")
	if old then old:Destroy() end
	local model = Instance.new("Model")
	model.Name = "NH_Morph"
	model:SetAttribute("Kind", kind)
	-- align feet with the floor: HRP is HipHeight + half its height above the ground
	local hum = character:FindFirstChildOfClass("Humanoid")
	local groundOffset = (hum and hum.RigType == Enum.HumanoidRigType.R15) and (hum.HipHeight + hrp.Size.Y / 2) or 3
	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.new(1, 1, 1)
	root.Transparency = 1
	root.CanCollide = false
	root.CanQuery = false
	root.CanTouch = false
	root.Massless = true
	root.CFrame = hrp.CFrame * CFrame.new(0, 3 - groundOffset, 0)
	root.Parent = model
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = hrp
	weld.Part1 = root
	weld.Parent = root
	local P = builder(model, root, false);
	(BUILD[kind] or BUILD.freddy)(P)
	model.PrimaryPart = root
	-- hide the player's own avatar
	for _, d in ipairs(character:GetDescendants()) do
		if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" and not d:IsDescendantOf(model) then
			d.Transparency = 1
		elseif d:IsA("Decal") then
			d.Transparency = 1
		end
	end
	local glow = Instance.new("PointLight")
	glow.Color = kind == "locust" and Color3.fromRGB(200, 255, 80) or Color3.fromRGB(255, 40, 40)
	glow.Range = 14
	glow.Brightness = 0.7
	glow.Parent = root
	model.Parent = character
	return model
end

-- Anchored copy of a monster at the origin (feet at y=0), for the jumpscare viewport.
function Models.template(kind)
	local model = Instance.new("Model")
	model.Name = kind
	local root = Instance.new("Part")
	root.Name = "Root"
	root.Anchored = true
	root.Transparency = 1
	root.Size = Vector3.new(1, 1, 1)
	root.CFrame = CFrame.new(0, 3, 0)
	root.Parent = model
	local P = builder(model, root, true);
	(BUILD[kind] or BUILD.freddy)(P)
	model.PrimaryPart = root
	return model
end

-- Anchored helicopter at cframe. Returns model and a list of rotor parts to spin.
function Models.helicopter(cf, bodyColor)
	local model = Instance.new("Model")
	model.Name = "Helicopter"
	local base = Instance.new("Part")
	base.Anchored = true
	base.Transparency = 1
	base.CanCollide = false
	base.Size = Vector3.new(1, 1, 1)
	base.CFrame = cf
	base.Parent = model
	local P = builder(model, base, true)
	local c = bodyColor or Color3.fromRGB(45, 90, 58)
	P(Vector3.new(7, 5, 11), at(0, 4.5, 0), c, { collide = true })                                -- cabin
	P(Vector3.new(6, 3.5, 3), at(0, 5, -6.2), Color3.fromRGB(159, 211, 255), { mat = GLASS, transp = 0.35 }) -- windshield
	P(Vector3.new(1.4, 1.4, 12), at(0, 5.5, 11.5), c)                                            -- tail boom
	P(Vector3.new(0.5, 4, 2.4), at(0, 7, 17.2), c)                                               -- tail fin
	P(Vector3.new(0.6, 0.6, 12), at(-3, 0.6, 0), Color3.fromRGB(30, 30, 30), { mat = METAL })   -- skids
	P(Vector3.new(0.6, 0.6, 12), at(3, 0.6, 0), Color3.fromRGB(30, 30, 30), { mat = METAL })
	P(Vector3.new(0.4, 1.6, 0.4), at(-3, 1.4, -3), Color3.fromRGB(30, 30, 30))
	P(Vector3.new(0.4, 1.6, 0.4), at(3, 1.4, -3), Color3.fromRGB(30, 30, 30))
	P(Vector3.new(0.4, 1.6, 0.4), at(-3, 1.4, 3), Color3.fromRGB(30, 30, 30))
	P(Vector3.new(0.4, 1.6, 0.4), at(3, 1.4, 3), Color3.fromRGB(30, 30, 30))
	P(Vector3.new(1.2, 1, 1.2), at(0, 7.4, 0), Color3.fromRGB(40, 40, 40), { mat = METAL })     -- rotor hub
	local r1 = P(Vector3.new(26, 0.2, 1.1), at(0, 8, 0), Color3.fromRGB(35, 35, 35), { name = "Rotor" })
	local r2 = P(Vector3.new(1.1, 0.2, 26), at(0, 8, 0), Color3.fromRGB(35, 35, 35), { name = "Rotor" })
	local light = Instance.new("PointLight")
	light.Range = 30
	light.Brightness = 1.2
	light.Color = Color3.fromRGB(120, 255, 140)
	light.Parent = base
	model.PrimaryPart = base
	return model, { r1, r2 }
end

return Models
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="8">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="9">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="10">
        <Properties>
          <string name="Name">NightHuntClient</string>
          <string name="Source"><![CDATA[--[[ Night Hunt (fan-made) - client: UI, lighting, input, effects ]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")
local SocialService = game:GetService("SocialService")

local player = Players.LocalPlayer
local Shared = ReplicatedStorage:WaitForChild("NightHunt")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = Shared:WaitForChild("Remotes")
local Action = Remotes:WaitForChild("Action")
local Notify = Remotes:WaitForChild("Notify")
local Hub = Remotes:WaitForChild("Hub")
local State = Shared:WaitForChild("State")
local Templates = Shared:WaitForChild("Templates")

---------------------------------------------------------------------------
-- UI helpers
---------------------------------------------------------------------------
local RED = Color3.fromRGB(200, 35, 35)
local DARK = Color3.fromRGB(14, 12, 16)
local PANEL = Color3.fromRGB(24, 20, 26)
local TEXT = Color3.fromRGB(235, 228, 220)
local MUTED = Color3.fromRGB(150, 140, 140)

local gui = Instance.new("ScreenGui")
gui.Name = "NightHuntUI"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = player:WaitForChild("PlayerGui")

local function new(className, props, parent)
	local i = Instance.new(className)
	for k, v in pairs(props) do i[k] = v end
	i.Parent = parent
	return i
end
local function corner(o, r) new("UICorner", { CornerRadius = UDim.new(0, r or 8) }, o) end
local function label(parent, text, size, props)
	local l = new("TextLabel", {
		BackgroundTransparency = 1, Text = text, TextColor3 = TEXT, Font = Enum.Font.GothamMedium,
		TextSize = size or 16, TextWrapped = true, Size = UDim2.new(1, 0, 0, (size or 16) + 6),
	}, parent)
	for k, v in pairs(props or {}) do l[k] = v end
	return l
end
local function button(parent, text, props, onClick)
	local b = new("TextButton", {
		BackgroundColor3 = RED, Text = text, TextColor3 = Color3.new(1, 1, 1), Font = Enum.Font.GothamBold,
		TextSize = 16, Size = UDim2.new(1, 0, 0, 36), AutoButtonColor = true,
	}, parent)
	corner(b, 6)
	for k, v in pairs(props or {}) do b[k] = v end
	if onClick then b.MouseButton1Click:Connect(onClick) end
	return b
end
local function textbox(parent, placeholder, props)
	local t = new("TextBox", {
		BackgroundColor3 = DARK, PlaceholderText = placeholder, Text = "", TextColor3 = TEXT,
		PlaceholderColor3 = MUTED, Font = Enum.Font.Gotham, TextSize = 16, ClearTextOnFocus = false,
		Size = UDim2.new(1, 0, 0, 34),
	}, parent)
	corner(t, 6)
	for k, v in pairs(props or {}) do t[k] = v end
	return t
end
local function list(parent, pad)
	new("UIListLayout", { Padding = UDim.new(0, pad or 6), SortOrder = Enum.SortOrder.LayoutOrder, HorizontalAlignment = Enum.HorizontalAlignment.Center }, parent)
end
local function padding(parent, px)
	new("UIPadding", { PaddingTop = UDim.new(0, px), PaddingBottom = UDim.new(0, px), PaddingLeft = UDim.new(0, px), PaddingRight = UDim.new(0, px) }, parent)
end

---------------------------------------------------------------------------
-- HUD
---------------------------------------------------------------------------
local top = new("Frame", { BackgroundColor3 = DARK, BackgroundTransparency = 0.25, Size = UDim2.new(0, 360, 0, 58), Position = UDim2.new(0.5, -180, 0, 8) }, gui)
corner(top, 10)
local stateLbl = label(top, "NIGHT HUNT", 22, { Font = Enum.Font.Creepster, TextColor3 = RED, Position = UDim2.new(0, 0, 0, 4) })
local subLbl = label(top, "", 14, { TextColor3 = MUTED, Position = UDim2.new(0, 0, 0, 32) })

local roleCard = new("Frame", { BackgroundColor3 = DARK, BackgroundTransparency = 0.2, Size = UDim2.new(0, 270, 0, 150), Position = UDim2.new(0, 12, 1, -230), Visible = false }, gui)
corner(roleCard, 10)
padding(roleCard, 10)
list(roleCard, 4)
local roleTitle = label(roleCard, "", 20, { Font = Enum.Font.GothamBlack, LayoutOrder = 1 })
local roleDesc = label(roleCard, "", 13, { TextColor3 = MUTED, LayoutOrder = 2, Size = UDim2.new(1, 0, 0, 34) })
local abilityBtn = button(roleCard, "", { LayoutOrder = 3, TextSize = 14 }, function() Action:FireServer("ability") end)
local abilityDesc = label(roleCard, "", 12, { TextColor3 = MUTED, LayoutOrder = 4, Size = UDim2.new(1, 0, 0, 30) })

local staminaBg = new("Frame", { BackgroundColor3 = DARK, Size = UDim2.new(0, 220, 0, 10), Position = UDim2.new(0.5, -110, 1, -34), Visible = false }, gui)
corner(staminaBg, 5)
local staminaFill = new("Frame", { BackgroundColor3 = Color3.fromRGB(230, 200, 80), Size = UDim2.new(1, 0, 1, 0) }, staminaBg)
corner(staminaFill, 5)
local staminaHint = label(staminaBg, "Shift = sprint", 12, { TextColor3 = MUTED, Position = UDim2.new(0, 0, 0, -20) })

local logFrame = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(0, 330, 0, 200), Position = UDim2.new(1, -342, 0, 80) }, gui)
new("UIListLayout", { Padding = UDim.new(0, 4), VerticalAlignment = Enum.VerticalAlignment.Top, SortOrder = Enum.SortOrder.LayoutOrder }, logFrame)
local logN = 0
local function toast(msg)
	logN += 1
	local l = label(logFrame, msg, 14, {
		BackgroundTransparency = 0.35, BackgroundColor3 = DARK, TextXAlignment = Enum.TextXAlignment.Left,
		AutomaticSize = Enum.AutomaticSize.Y, Size = UDim2.new(1, 0, 0, 0), LayoutOrder = logN,
	})
	padding(l, 5)
	corner(l, 6)
	local kids = {}
	for _, c in ipairs(logFrame:GetChildren()) do if c:IsA("TextLabel") then table.insert(kids, c) end end
	table.sort(kids, function(a, b) return a.LayoutOrder < b.LayoutOrder end)
	while #kids > 6 do table.remove(kids, 1):Destroy() end
	task.delay(7, function()
		if l.Parent then
			TweenService:Create(l, TweenInfo.new(0.6), { TextTransparency = 1, BackgroundTransparency = 1 }):Play()
			task.wait(0.7)
			l:Destroy()
		end
	end)
end

---------------------------------------------------------------------------
-- Hub panel (create / join / public list)
---------------------------------------------------------------------------
local hub = new("Frame", { BackgroundColor3 = PANEL, Size = UDim2.new(0, 420, 0, 470), Position = UDim2.new(0.5, -210, 0.5, -215), Visible = false }, gui)
corner(hub, 12)
padding(hub, 14)
list(hub, 8)
label(hub, "NIGHT HUNT", 38, { Font = Enum.Font.Creepster, TextColor3 = RED, LayoutOrder = 1 })
label(hub, "Fan-made monster survival - 2 to 15 players", 13, { TextColor3 = MUTED, LayoutOrder = 2 })
local tabs = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 32), LayoutOrder = 3 }, hub)
new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6) }, tabs)
local pages = {}
local tabButtons = {}
local function showTab(name)
	for n, pg in pairs(pages) do pg.Visible = n == name end
	for n, b in pairs(tabButtons) do b.BackgroundColor3 = n == name and RED or DARK end
end
for i, n in ipairs({ "Create", "Join code", "Public servers" }) do
	tabButtons[n] = button(tabs, n, { Size = UDim2.new(1 / 3, -4, 1, 0), LayoutOrder = i, TextSize = 14 }, function() showTab(n) end)
	local pg = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 300), LayoutOrder = 4, Visible = false }, hub)
	list(pg, 8)
	pages[n] = pg
end
local hubStatus = label(hub, "", 13, { TextColor3 = Color3.fromRGB(255, 200, 120), LayoutOrder = 5, Size = UDim2.new(1, 0, 0, 34) })

-- Create page
local createMax = 8
local createPublic = false
local cp = pages["Create"]
local nameBox = textbox(cp, "Server name (optional)", { LayoutOrder = 1 })
local maxRow = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 36), LayoutOrder = 2 }, cp)
local maxLbl = label(maxRow, "", 16, { Size = UDim2.new(1, -100, 1, 0), TextXAlignment = Enum.TextXAlignment.Left })
local function refreshMax() maxLbl.Text = ("Max players: %d"):format(createMax) end
button(maxRow, "-", { Size = UDim2.new(0, 44, 1, 0), Position = UDim2.new(1, -94, 0, 0) }, function() createMax = math.max(2, createMax - 1); refreshMax() end)
button(maxRow, "+", { Size = UDim2.new(0, 44, 1, 0), Position = UDim2.new(1, -44, 0, 0) }, function() createMax = math.min(Config.MAX_PLAYERS, createMax + 1); refreshMax() end)
refreshMax()
local privacyBtn
local function refreshPrivacy()
	privacyBtn.Text = createPublic and "Privacy: PUBLIC (listed in the server browser)" or "Privacy: FRIENDS ONLY (join by code / invite)"
	privacyBtn.BackgroundColor3 = createPublic and Color3.fromRGB(40, 110, 60) or Color3.fromRGB(70, 60, 120)
end
privacyBtn = button(cp, "", { LayoutOrder = 3, TextSize = 13 }, function() createPublic = not createPublic; refreshPrivacy() end)
refreshPrivacy()
local busy = false
button(cp, "CREATE SERVER", { LayoutOrder = 4, Size = UDim2.new(1, 0, 0, 44), TextSize = 18 }, function()
	if busy then return end
	busy = true
	hubStatus.Text = "Creating server..."
	local ok, res = pcall(function() return Hub:InvokeServer("create", { name = nameBox.Text, max = createMax, public = createPublic }) end)
	busy = false
	hubStatus.Text = ok and res and res.msg or "Something went wrong."
end)
label(cp, "You'll be flown to your own private server. Share its code with friends, or make it public.", 12, { TextColor3 = MUTED, LayoutOrder = 5, Size = UDim2.new(1, 0, 0, 32) })

-- Join page
local jp = pages["Join code"]
local codeBox = textbox(jp, "Enter server code, e.g. K7Q2M", { LayoutOrder = 1, TextSize = 20 })
button(jp, "JOIN", { LayoutOrder = 2, Size = UDim2.new(1, 0, 0, 44), TextSize = 18 }, function()
	if busy then return end
	busy = true
	hubStatus.Text = "Looking up " .. codeBox.Text:upper() .. "..."
	local ok, res = pcall(function() return Hub:InvokeServer("join", codeBox.Text) end)
	busy = false
	hubStatus.Text = ok and res and res.msg or "Something went wrong."
end)

-- Public list page
local pp = pages["Public servers"]
local scroller = new("ScrollingFrame", { BackgroundColor3 = DARK, Size = UDim2.new(1, 0, 0, 250), LayoutOrder = 2, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 6 }, pp)
corner(scroller, 6)
padding(scroller, 6)
list(scroller, 6)
local function refreshList()
	local ok, res = pcall(function() return Hub:InvokeServer("list") end)
	for _, c in ipairs(scroller:GetChildren()) do if c:IsA("Frame") or c:IsA("TextLabel") then c:Destroy() end end
	if not ok or not res then label(scroller, "Couldn't load servers.", 14); return end
	if #res.servers == 0 then
		label(scroller, State:GetAttribute("Studio") and "The server browser works in the published game." or "No public servers right now - create one!", 14, { TextColor3 = MUTED })
	end
	for i, s in ipairs(res.servers) do
		local row = new("Frame", { BackgroundColor3 = PANEL, Size = UDim2.new(1, 0, 0, 46), LayoutOrder = i }, scroller)
		corner(row, 6)
		label(row, ("%s"):format(s.name), 15, { TextXAlignment = Enum.TextXAlignment.Left, Position = UDim2.new(0, 8, 0, 2), Size = UDim2.new(1, -90, 0, 20) })
		label(row, ("host %s - %d/%d - %s"):format(s.host or "?", s.players, s.max, s.state == "Lobby" and "in lobby" or "round in progress"), 12, { TextColor3 = MUTED, TextXAlignment = Enum.TextXAlignment.Left, Position = UDim2.new(0, 8, 0, 24), Size = UDim2.new(1, -90, 0, 16) })
		local full = s.players >= s.max
		button(row, full and "FULL" or "JOIN", { Size = UDim2.new(0, 70, 0, 32), Position = UDim2.new(1, -78, 0, 7), BackgroundColor3 = full and Color3.fromRGB(70, 70, 70) or RED }, function()
			if full then return end
			hubStatus.Text = "Joining " .. s.name .. "..."
			local ok2, r2 = pcall(function() return Hub:InvokeServer("join", s.code) end)
			hubStatus.Text = ok2 and r2 and r2.msg or "Something went wrong."
		end)
	end
end
button(pp, "Refresh", { LayoutOrder = 1, Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = Color3.fromRGB(60, 50, 60) }, refreshList)
tabButtons["Public servers"].MouseButton1Click:Connect(refreshList)
showTab("Create")
local hubToggle = button(gui, "Servers", { Size = UDim2.new(0, 110, 0, 34), Position = UDim2.new(0, 12, 0, 12), Visible = false }, function() hub.Visible = not hub.Visible end)

---------------------------------------------------------------------------
-- Match lobby panel
---------------------------------------------------------------------------
local lobbyPanel = new("Frame", { BackgroundColor3 = PANEL, BackgroundTransparency = 0.1, Size = UDim2.new(0, 290, 0, 400), Position = UDim2.new(1, -302, 1, -412), Visible = false }, gui)
corner(lobbyPanel, 12)
padding(lobbyPanel, 10)
list(lobbyPanel, 6)
local lpName = label(lobbyPanel, "", 18, { Font = Enum.Font.GothamBlack, LayoutOrder = 1 })
local lpCode = label(lobbyPanel, "", 15, { TextColor3 = Color3.fromRGB(255, 210, 120), LayoutOrder = 2, Size = UDim2.new(1, 0, 0, 38) })
local lpPlayers = new("TextLabel", { BackgroundColor3 = DARK, TextColor3 = TEXT, Font = Enum.Font.Gotham, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, Size = UDim2.new(1, 0, 0, 130), LayoutOrder = 3, TextWrapped = true }, lobbyPanel)
corner(lpPlayers, 6)
padding(lpPlayers, 6)
local hostRow = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 32), LayoutOrder = 4 }, lobbyPanel)
local hostMaxLbl = label(hostRow, "", 14, { Size = UDim2.new(1, -84, 1, 0), TextXAlignment = Enum.TextXAlignment.Left })
button(hostRow, "-", { Size = UDim2.new(0, 38, 1, 0), Position = UDim2.new(1, -80, 0, 0) }, function() Action:FireServer("settings", { max = (State:GetAttribute("MaxPlayers") or 8) - 1 }) end)
button(hostRow, "+", { Size = UDim2.new(0, 38, 1, 0), Position = UDim2.new(1, -38, 0, 0) }, function() Action:FireServer("settings", { max = (State:GetAttribute("MaxPlayers") or 8) + 1 }) end)
local hostPrivacy = button(lobbyPanel, "", { LayoutOrder = 5, TextSize = 13 }, function() Action:FireServer("settings", { public = not State:GetAttribute("IsPublic") }) end)
local takeOff = button(lobbyPanel, "TAKE OFF", { LayoutOrder = 6, Size = UDim2.new(1, 0, 0, 44), TextSize = 20 }, function() Action:FireServer("start") end)
local inviteBtn = button(lobbyPanel, "Invite friends", { LayoutOrder = 7, BackgroundColor3 = Color3.fromRGB(70, 60, 120) }, function()
	local opts = Instance.new("ExperienceInviteOptions")
	opts.PromptMessage = "Join my Night Hunt server!"
	opts.LaunchData = State:GetAttribute("ServerCode") or ""
	local ok, can = pcall(function() return SocialService:CanSendGameInviteAsync(player) end)
	if ok and can then
		pcall(function() SocialService:PromptGameInvite(player, opts) end)
	else
		toast("Invites aren't available here - share the code instead.")
	end
end)
local lpHint = label(lobbyPanel, "", 12, { TextColor3 = MUTED, LayoutOrder = 8, Size = UDim2.new(1, 0, 0, 40) })

---------------------------------------------------------------------------
-- Overlays: flight, results, jumpscare, effects
---------------------------------------------------------------------------
local overlay = new("Frame", { BackgroundColor3 = Color3.new(0, 0, 0), Size = UDim2.fromScale(1, 1), Visible = false, ZIndex = 20 }, gui)
local overlayTitle = label(overlay, "", 48, { Font = Enum.Font.Creepster, TextColor3 = RED, Position = UDim2.new(0, 0, 0.32, 0), Size = UDim2.new(1, 0, 0, 60), ZIndex = 21 })
local overlayText = label(overlay, "", 18, { Position = UDim2.new(0.1, 0, 0.32, 70), Size = UDim2.new(0.8, 0, 0, 220), TextYAlignment = Enum.TextYAlignment.Top, ZIndex = 21 })

local scare = new("ViewportFrame", { BackgroundColor3 = Color3.new(0, 0, 0), Size = UDim2.fromScale(1, 1), Visible = false, ZIndex = 30, Ambient = Color3.fromRGB(255, 120, 120), LightColor = Color3.fromRGB(255, 220, 220) }, gui)
local scareCam = Instance.new("Camera")
scareCam.FieldOfView = 50
scareCam.Parent = scare
scare.CurrentCamera = scareCam
local scareText = label(scare, "CAUGHT", 70, { Font = Enum.Font.Creepster, TextColor3 = RED, Position = UDim2.new(0, 0, 0.78, 0), Size = UDim2.new(1, 0, 0, 80), ZIndex = 31 })

local function jumpscare(kind)
	for _, c in ipairs(scare:GetChildren()) do if c:IsA("Model") then c:Destroy() end end
	local t = Templates:FindFirstChild(kind) or Templates:FindFirstChild("freddy")
	local m = t:Clone()
	m.Parent = scare
	local cf, size = m:GetBoundingBox()
	local headY = cf.Position.Y + size.Y / 2 - 2.2
	local def = Config.MONSTERS[kind]
	scareText.Text = def and (def.name:upper() .. " GOT YOU") or "CAUGHT"
	scare.Visible = true
	local start = os.clock()
	local conn
	conn = RunService.RenderStepped:Connect(function()
		local e = os.clock() - start
		local dist = math.max(3.2, 9 - e * 14)
		local shake = Vector3.new(math.random() - 0.5, math.random() - 0.5, 0) * 0.35
		scareCam.CFrame = CFrame.lookAt(Vector3.new(0, headY, -dist) + shake, Vector3.new(0, headY, 0))
		if e > 1.8 then
			conn:Disconnect()
			scare.Visible = false
		end
	end)
	local s = Instance.new("Sound")
	s.SoundId = "rbxasset://sounds/electronicpingshort.wav"
	s.PlaybackSpeed = 0.35
	s.Volume = 2
	s.Parent = gui
	s:Play()
	game:GetService("Debris"):AddItem(s, 3)
end

local grey = Instance.new("ColorCorrectionEffect")
grey.Name = "NH_Grey"
grey.Enabled = false
grey.Parent = Lighting
local greyUntil = 0

---------------------------------------------------------------------------
-- Lighting per state / role
---------------------------------------------------------------------------
local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere") or new("Atmosphere", {}, Lighting)
local function applyLighting()
	local st = State:GetAttribute("State")
	local role = player:GetAttribute("Role")
	local inMap = st == "Hunt" and (role == "Monster" or (role == "Survivor" and player:GetAttribute("Alive") and not player:GetAttribute("Escaped")))
	Lighting.GlobalShadows = true
	if inMap then
		Lighting.ClockTime = 0
		Lighting.Brightness = 0.2
		Lighting.EnvironmentDiffuseScale = 0
		Lighting.EnvironmentSpecularScale = 0
		Lighting.OutdoorAmbient = role == "Monster" and Color3.fromRGB(70, 25, 25) or Color3.fromRGB(12, 12, 16)
		Lighting.Ambient = role == "Monster" and Color3.fromRGB(60, 20, 20) or Color3.fromRGB(6, 6, 8)
		Lighting.FogColor = State:GetAttribute("FogColor") or Color3.new(0, 0, 0)
		Lighting.FogEnd = (State:GetAttribute("FogEnd") or 120) * (role == "Monster" and 1.4 or 1)
		Lighting.FogStart = 8
		atmosphere.Density = 0.45
		atmosphere.Color = State:GetAttribute("FogColor") or Color3.new(0, 0, 0)
		atmosphere.Haze = 2
	else
		Lighting.ClockTime = 19.2
		Lighting.Brightness = 1.2
		Lighting.EnvironmentDiffuseScale = 0.5
		Lighting.EnvironmentSpecularScale = 0.5
		Lighting.OutdoorAmbient = Color3.fromRGB(90, 80, 100)
		Lighting.Ambient = Color3.fromRGB(50, 45, 60)
		Lighting.FogEnd = 400
		Lighting.FogStart = 100
		Lighting.FogColor = Color3.fromRGB(40, 30, 45)
		atmosphere.Density = 0.3
		atmosphere.Color = Color3.fromRGB(80, 60, 80)
		atmosphere.Haze = 1
	end
end

---------------------------------------------------------------------------
-- Input: ability (E / touch button), sprint (Shift / touch button)
---------------------------------------------------------------------------
ContextActionService:BindAction("NH_Ability", function(_, inputState)
	if inputState == Enum.UserInputState.Begin then Action:FireServer("ability") end
	return Enum.ContextActionResult.Sink
end, true, Enum.KeyCode.E, Enum.KeyCode.ButtonX)
ContextActionService:SetTitle("NH_Ability", "Power")
ContextActionService:SetPosition("NH_Ability", UDim2.new(1, -150, 1, -150))
ContextActionService:BindAction("NH_Sprint", function(_, inputState)
	if inputState == Enum.UserInputState.Begin then Action:FireServer("sprint", true)
	elseif inputState == Enum.UserInputState.End or inputState == Enum.UserInputState.Cancel then Action:FireServer("sprint", false) end
	return Enum.ContextActionResult.Pass
end, true, Enum.KeyCode.LeftShift, Enum.KeyCode.RightShift, Enum.KeyCode.ButtonL3)
ContextActionService:SetTitle("NH_Sprint", "Run")
ContextActionService:SetPosition("NH_Sprint", UDim2.new(1, -210, 1, -90))

---------------------------------------------------------------------------
-- Server notifications
---------------------------------------------------------------------------
local resultsUntil = 0
Notify.OnClientEvent:Connect(function(kind, a, b)
	if kind == "toast" then
		toast(a)
	elseif kind == "jumpscare" then
		jumpscare(a)
	elseif kind == "effect" then
		if a == "grey" then greyUntil = os.clock() + b end
		if a == "lightsout" then toast("Your flashlight died...") end
	elseif kind == "escaped" then
		toast("You escaped! Watch from the lobby.")
	elseif kind == "flight" then
		overlay.Visible = true
		overlayTitle.Text = "TAKING OFF..."
		local role = player:GetAttribute("Role")
		if role == "Monster" then
			local def = Config.MONSTERS[player:GetAttribute("Monster")] or Config.MONSTERS.freddy
			overlayText.Text = ("Flying to %s\n\nYou are %s!\nCatch every survivor before they escape.\nPower: %s - %s"):format(a, def.name:upper(), def.ability, def.desc)
		else
			overlayText.Text = ("Flying to %s\n\nYou are a SURVIVOR.\nStay hidden, use your flashlight, and reach the extraction helicopter when it lands (%ds left)."):format(a, Config.EXTRACT_AT)
		end
	elseif kind == "results" then
		resultsUntil = os.clock() + Config.RESULTS_TIME
		overlay.Visible = true
		overlayTitle.Text = a
		overlayText.Text = table.concat(b, "\n")
	end
end)

---------------------------------------------------------------------------
-- Per-frame update
---------------------------------------------------------------------------
local rotors = {}
local rotorRel = {}
local flickers = {}
local function fmtTime(t) return ("%d:%02d"):format(math.floor(t / 60), t % 60) end

RunService.RenderStepped:Connect(function(dt)
	local mode = State:GetAttribute("Mode")
	local st = State:GetAttribute("State")
	local role = player:GetAttribute("Role") or ""
	local tl = State:GetAttribute("TimeLeft") or 0

	-- top bar
	if mode == "Hub" then
		stateLbl.Text = "NIGHT HUNT"
		subLbl.Text = "Create a server, join a code, or browse public servers"
	elseif st == "Lobby" then
		stateLbl.Text = "LOBBY"
		subLbl.Text = "Walk onto the helipad to board"
	elseif st == "Flight" then
		stateLbl.Text = "IN FLIGHT"
		subLbl.Text = State:GetAttribute("Theme") or ""
	elseif st == "Hunt" then
		stateLbl.Text = fmtTime(tl)
		local extra = State:GetAttribute("ExtractOpen") and "  -  EXTRACTION IS HERE" or ("  -  heli in " .. fmtTime(math.max(0, tl - Config.EXTRACT_AT)))
		subLbl.Text = (State:GetAttribute("Theme") or "") .. extra
	elseif st == "Results" then
		stateLbl.Text = "ROUND OVER"
		subLbl.Text = "Back to the lobby in " .. tl
	end

	-- hub / lobby panels
	hubToggle.Visible = mode == "Hub"
	if mode ~= "Hub" then hub.Visible = false end
	lobbyPanel.Visible = mode == "Match" and st == "Lobby"
	if lobbyPanel.Visible then
		local isHost = State:GetAttribute("HostUserId") == player.UserId
		local max = State:GetAttribute("MaxPlayers") or 15
		local public = State:GetAttribute("IsPublic")
		local code = State:GetAttribute("ServerCode") or ""
		lpName.Text = State:GetAttribute("ServerName") or "Night Hunt"
		lpCode.Text = (public and "PUBLIC" or "FRIENDS ONLY") .. (code ~= "" and ("  -  code: " .. code) or "")
		local lines, boarded, n = {}, 0, 0
		for _, p in ipairs(Players:GetPlayers()) do
			n += 1
			local b = p:GetAttribute("Boarded")
			if b then boarded += 1 end
			table.insert(lines, (b and "[on board] " or "[  walking ] ") .. p.DisplayName .. (p.UserId == State:GetAttribute("HostUserId") and "  (host)" or ""))
		end
		lpPlayers.Text = ("Players %d/%d  -  boarded %d\n"):format(n, max, boarded) .. table.concat(lines, "\n")
		hostRow.Visible = isHost
		hostMaxLbl.Text = ("Max players: %d"):format(max)
		hostPrivacy.Visible = isHost
		hostPrivacy.Text = public and "Make FRIENDS ONLY" or "Make PUBLIC"
		takeOff.Visible = isHost
		local minN = State:GetAttribute("Studio") and 1 or Config.MIN_PLAYERS
		local ready = n >= minN and boarded == n
		takeOff.BackgroundColor3 = ready and RED or Color3.fromRGB(70, 70, 70)
		takeOff.Text = ready and "TAKE OFF" or (n < minN and ("NEED %d+ PLAYERS"):format(minN) or "WAITING FOR BOARDING")
		lpHint.Text = isHost and "Everyone must stand on the helipad. Each player has a random chance to become a monster."
			or "Stand on the helipad. The host takes off when everyone is aboard."
	end

	-- overlays
	if st == "Flight" then
		overlay.Visible = true
	elseif st == "Results" then
		overlay.Visible = os.clock() < resultsUntil
	else
		overlay.Visible = false
	end

	-- role card
	local inRound = (st == "Hunt" or st == "Flight") and (role == "Monster" or role == "Survivor")
	roleCard.Visible = inRound
	staminaBg.Visible = inRound and role == "Survivor" and player:GetAttribute("Alive") and not player:GetAttribute("Escaped")
	if inRound then
		if role == "Monster" then
			local def = Config.MONSTERS[player:GetAttribute("Monster")] or Config.MONSTERS.freddy
			roleTitle.Text = def.name:upper()
			roleTitle.TextColor3 = RED
			roleDesc.Text = "You are a monster. Catch every survivor!"
			local left = (player:GetAttribute("AbilityReadyAt") or 0) - workspace:GetServerTimeNow()
			local name = def.ability
			if player:GetAttribute("Monster") == "demogorgon" and player:GetAttribute("PortalSet") then name = "Jump to portal" end
			abilityBtn.Visible = true
			abilityBtn.Text = left > 0 and ("%s (%ds)"):format(name, math.ceil(left)) or ("[E] " .. name)
			abilityBtn.BackgroundColor3 = left > 0 and Color3.fromRGB(70, 70, 70) or RED
			abilityDesc.Text = def.desc
		else
			roleTitle.Text = player:GetAttribute("Escaped") and "ESCAPED" or (player:GetAttribute("Alive") and "SURVIVOR" or "CAUGHT")
			roleTitle.TextColor3 = Color3.fromRGB(120, 200, 255)
			roleDesc.Text = State:GetAttribute("ExtractOpen") and "Get to the helicopter - follow the green beam!" or "Hide, run, and survive until extraction."
			abilityBtn.Visible = false
			abilityDesc.Text = "Shift: sprint. Hide inside bushes and crates."
		end
	end
	staminaFill.Size = UDim2.new((player:GetAttribute("Stamina") or 100) / 100, 0, 1, 0)
	staminaFill.BackgroundColor3 = player:GetAttribute("CanSprint") == false and Color3.fromRGB(120, 120, 120) or Color3.fromRGB(230, 200, 80)
	staminaHint.Text = player:GetAttribute("CanSprint") == false and "can't sprint!" or "Shift = sprint"

	-- effects
	local g = os.clock() < greyUntil
	grey.Enabled = g
	grey.Saturation = -1
	grey.Contrast = 0.2
	applyLighting()

	-- spin every helicopter rotor, flicker lights
	for _, part in ipairs(rotors) do
		if part.Parent then
			local base = part.Parent.PrimaryPart
			local rel = rotorRel[part]
			if base and rel then
				local spin = (os.clock() * 14) % (math.pi * 2)
				part.CFrame = base.CFrame * CFrame.Angles(0, spin, 0) * rel
			end
		end
	end
	for _, bulb in ipairs(flickers) do
		if bulb.Parent then
			local l = bulb:FindFirstChildOfClass("PointLight")
			if l and math.random() < 0.02 then
				l.Enabled = not l.Enabled
				bulb.Transparency = l.Enabled and 0 or 0.7
			end
		end
	end
end)

local function track(d)
	if d:IsA("BasePart") and d.Name == "Rotor" then
		task.defer(function()
			local base = d.Parent and d.Parent.PrimaryPart
			if base then
				rotorRel[d] = base.CFrame:ToObjectSpace(d.CFrame)
				table.insert(rotors, d)
			end
		end)
	elseif d:IsA("BasePart") and d.Name == "FlickerLight" then
		table.insert(flickers, d)
	end
end
for _, d in ipairs(workspace:GetDescendants()) do track(d) end
workspace.DescendantAdded:Connect(track)
task.spawn(function()
	while true do
		task.wait(5)
		for i = #rotors, 1, -1 do if not rotors[i].Parent then rotorRel[rotors[i]] = nil; table.remove(rotors, i) end end
		for i = #flickers, 1, -1 do if not flickers[i].Parent then table.remove(flickers, i) end end
	end
end)

-- first-time hub panel
task.defer(function()
	if State:GetAttribute("Mode") == "Hub" then hub.Visible = true end
end)
State:GetAttributeChangedSignal("Mode"):Connect(function()
	if State:GetAttribute("Mode") == "Match" then hub.Visible = false; toast("You're in your match server. Board the helicopter!") end
end)
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
