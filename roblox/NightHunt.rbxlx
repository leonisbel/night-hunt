		P(Vector3.new(0.7, 0.3, 1.3), at(x * 0.5, -3.1, -0.3), rgb(250, 250, 250))                -- cartoon shoes
	end
	P(Vector3.new(0.3, 4.5, 0.3), at(0, 1.8, 1.4, 35, 0, 0), black)                              -- tail
	P(Vector3.new(0.45, 0.25, 0.1), at(-0.7, 6.35, -1.55, 0, 0, -15), black)                     -- angry brows
